Screen {
    Column(align_items: stretch) {
        Label(text: "Before")
        for group in app.groups key group.id {
            Label(key: "header", text: group.id)
            for row in group.rows key row.id {
                RowItem(title: row.title) {
                    Label(text: "${row.title}/${app.suffix}")
                }
            }
        }
        Label(text: "After")
    }
}
