component Aliases() {
    mount { app.remember("first", first); app.remember("second", second); app.remember("third", third) }
    Absolute {
        View(id: card, width: 77)
        NamedCard(id: first, x: 12, y: 13, key: "first-key", width: 100)
        AnonymousCard(id: second, key: "second-key", width: 200)
        NestedCard(id: third, key: "third-key", width: card.width)
        View(id: observer, width: first.width, height: second.height, x: third.width)
        Button(on_click: app.level = first.width + second.height)
        for item in app.rows key item.id {
            Label(text: first.width)
        }
    }
}
