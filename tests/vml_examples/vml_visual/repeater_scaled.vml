ScaledContent(width: 400, height: 300, content_width: 800, content_height: 600) {
    View()
    for item in app.rows key item.id {
        View()
    }
    for group in app.groups key group.id {
        for row in group.rows key row.id {
            View()
        }
    }
    for item in app.rows key "zero-${item.id}" {
        View(width: 0, height: 0)
    }
}
