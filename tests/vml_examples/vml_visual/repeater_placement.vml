Absolute(width: 300, height: 200) {
    Label(x: 0, text: "Niñez", style: [font_size(12)])
    for index, item in app.rows key item.id {
        Label(x: index * 10, text: "Niñez", style: [font_size(12)])
    }
    for group in app.groups key group.id {
        for index, row in group.rows key row.id {
            Label(x: index * 10, text: "Niñez", style: [font_size(12)])
        }
    }
    for index, item in app.rows key "zero-${item.id}" {
        Label(x: index * 10, text: "Niñez", width: 0, height: 0)
    }
    View() {
        Label(text: "Niñez", style: [font_size(12)])
    }
    View() {
        for item in app.rows key item.id {
            Label(text: "Niñez", style: [font_size(12)])
        }
    }
}
