# The V compiler ui2 is verified against. scripts/setup-v.sh and the CI setup
# action both read this file; change the pin here only.
V_REPOSITORY=tomaszbk/v
V_REVISION=913787be39ab8856bff326a586db147eb31b2b15
# Generated C bootstrap snapshot. The October 1 snapshot misgenerates Windows
# CreatePipe output pointers, so use the one preceding the V source pin.
VC_REVISION=08ee621c4d106318467bb1b316a0e592fca4bc83
# Platform bundles that supply V's default Boehm GC library.
TCC_REVISION_LINUX=d6e7ac1b1bcc98aed734a6ecbfa8509f24606c74
TCC_REVISION_MACOS=1d0ad0ecf70a91a1df64cebf215e683b1d5aedb5
TCC_REVISION_WINDOWS=dc80dc81dcb8df649456090348b504b0be97a623
