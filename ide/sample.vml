Screen(
    id: "WelcomeForm",
    width: 760,
    height: 520,
    style: [background(#F8FAFC)],
) {
    Absolute {
        Label(id: "heading", x: 48, y: 48, width: 420, height: 38, text: "Welcome to UI2", style: [foreground(#172033), font_size(26)])
        Label(
            id: "subtitle",
            x: 48,
            y: 94,
            width: 520,
            height: 28,
            text: "This form was laid out visually.",
            style: [foreground(#64748B), font_size(14)],
        )
        TextInput(
            id: "name_field",
            x: 48,
            y: 158,
            width: 280,
            height: 40,
            placeholder: "Your name",
            on_change: callback_name_changed,
            style: [background(#FFFFFF), foreground(#172033), font_size(14), radius(5)],
        )
        Checkbox(
            id: "remember",
            x: 48,
            y: 216,
            width: 210,
            height: 30,
            text: "Remember this setting",
            checked: true,
            style: [foreground(#172033), font_size(14)],
        )
        Button(
            id: "continue_button",
            x: 48,
            y: 270,
            width: 150,
            height: 42,
            text: "Continue",
            on_click: callback_continue_clicked,
            style: [background(#2563EB), foreground(#FFFFFF), font_size(14), radius(6)],
        )
        View(id: "accent_panel", x: 390, y: 150, width: 280, height: 210, style: [background(#DBEAFE), radius(4)])
    }
}
