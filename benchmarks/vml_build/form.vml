Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            x: 12,
            y: 12,
            width: (root.width - 24),
            height: root.height - 24,
            style: [background(#1F2937), radius(12)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: app.display,
                    x: 10,
                    y: 8,
                    width: (root.width - 24) - 20,
                    height: 48,
                    style: [foreground(#FFFFFF), font_size(28), text_align(right)],
                )
                Repeater(
                    model: app.keys,
                    key: item.text,
                ) {
                    Button(
                        text: item.text,
                        x: 6 + item.column *((((root.width - 24) - 30) / 4) + 6),
                        y: 64 + item.row * 50,
                        width: (((root.width - 24) - 30) / 4),
                        height: 44,
                        style: [background(item.role == "operator" ? #3478D4 : #F8FAFC), foreground(item.role == "operator" ? #FFFFFF : #111827), font_size(18), weight(item.text == "=" ? 700 : 400), text_align(center), radius(8)],
                    )
                }
            }
        }
    }
}
