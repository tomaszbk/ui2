Flex(
    orientation: vertical,
    align_items: start,
) {
    Flex(
        id: row,
        gap: 4,
        align_items: start,
        width: 300,
    ) {
        for item in app.items key item.id {
            Flex(
                orientation: vertical,
                flex_basis: 0,
                flex_grow: 1,
            ) {
                Label(text: item.text, style: [lines(8)])
            }
        }
    }
}
