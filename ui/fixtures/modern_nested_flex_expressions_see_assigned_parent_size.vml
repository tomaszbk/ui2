Flex(
    gap: 20,
) {
    Flex(
        id: "content",
        width: 100,
        flex_grow: 1,
        orientation: vertical,
    ) {
        Absolute(
            transparent: true,
        ) {
            Label(id: "probe", text: "width=${content.width}", width: content.width, height: 20)
        }
    }
    View(width: 80, flex_shrink: 0)
}
