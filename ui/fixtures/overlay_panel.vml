component OverlayPanel(open bool = false) {
    View(id: panel, width: 400, height: 240) {
        Button(id: trigger, text: "Open", width: 100, height: 30)
		Button(id: other_trigger, text: "Next", width: 100, height: 30)
		Dialog(id: surface, width: 200, height: 100, open: open,
            anchor: open ? "other_trigger" : "trigger", owner: "panel", initial_focus: "first") {
            Button(id: first, text: "First", width: 100, height: 30)
        }
    }
}
