Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Grid 2", x: 18, y: 14, width: 200, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: reset_sort,
                    text: "Row order",
                    on_click: app.reset_sort(),
                    native: true,
                    x: card.width - 128,
                    y: 13,
                    width: 110,
                    height: 34,
                )
                Label(
                    text: "Typed columns: two text columns, two factor columns, and one boolean. Tap a header to sort, a row number to select, then edit the selected record below.",
                    x: 18,
                    y: 44,
                    width: card.width - 156,
                    height: 18,
                    style: [foreground(#64748B), font_size(11)],
                )
                View(
                    id: editor,
                    x: 18,
                    y: 70,
                    width: card.width - 36,
                    height: ((root.width < 680) ? 92 : 58),
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Row ${app.selected}",
                            x: 14,
                            y: 20,
                            width: 70,
                            height: 18,
                            style: [foreground(#334155), font_size(12), weight(700)],
                        )
                        TextInput(
                            id: edit_v1,
                            bind.text: app.edit_v1,
                            on_change: app.apply_edits(),
                            x: 88,
                            y: (root.width < 680) ? 8 : 12,
                            width: (root.width < 680) ?((root.width - 180) / 2) :((root.width - 288) / 4),
                            height: 34,
                            style: [background(#FFFFFF), radius(7)],
                        )
                        TextInput(
                            id: edit_v2,
                            bind.text: app.edit_v2,
                            on_change: app.apply_edits(),
                            x: (root.width < 680) ? 96 +((root.width - 180) / 2) : 96 +((root.width - 288) / 4),
                            y: (root.width < 680) ? 8 : 12,
                            width: (root.width < 680) ?((root.width - 180) / 2) :((root.width - 288) / 4),
                            height: 34,
                            style: [background(#FFFFFF), radius(7)],
                        )
                        Dropdown(
                            id: edit_sex,
                            bind.text: app.edit_sex,
                            on_change: app.apply_edits(),
                            x: (root.width < 680) ? 14 : 104 + 2 *((root.width - 288) / 4),
                            y: (root.width < 680) ? 50 : 12,
                            width: (root.width < 680) ?((root.width - 200) / 2) :((root.width - 288) / 4),
                            height: 34,
                            style: [background(#FFFFFF), radius(7)],
                        ) {
                            Option(text: "Male")
                            Option(text: "Female")
                        }
                        Dropdown(
                            id: edit_csp,
                            bind.text: app.edit_csp,
                            on_change: app.apply_edits(),
                            x: (root.width < 680) ? 22 +((root.width - 200) / 2) : 112 + 3 *((root.width - 288) / 4),
                            y: (root.width < 680) ? 50 : 12,
                            width: (root.width < 680) ?((root.width - 200) / 2) :((root.width - 288) / 4),
                            height: 34,
                            style: [background(#FFFFFF), radius(7)],
                        ) {
                            Option(text: "job1")
                            Option(text: "job2")
                            Option(text: "other")
                        }
                        Checkbox(
                            id: edit_worker,
                            text: "worker",
                            bind.checked: app.edit_worker,
                            on_click: app.apply_edits(),
                            x: (root.width < 680) ? 30 + 2 *((root.width - 200) / 2) : 120 + 4 *((root.width - 288) / 4),
                            y: (root.width < 680) ? 55 : 18,
                            width: 90,
                            height: 24,
                            style: [foreground(#334155), font_size(12)],
                        )
                    }
                }
                View(
                    id: header,
                    x: 18,
                    y: ((root.width < 680) ? 174 : 140),
                    width: card.width - 36,
                    height: 34,
                    style: [background(#334155), radius(6)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "#",
                            x: 0,
                            y: 8,
                            width: 56,
                            height: 18,
                            style: [text_align(center), foreground(#E2E8F0), font_size(11), weight(700)],
                        )
                        for item in app.columns key item.key {
                            Button(
                                text: item.label,
                                on_click: app.sort_by(item.key),
                                x: 58 + item.index *((root.width - 124) / 5),
                                y: 3,
                                width: ((root.width - 124) / 5) - 4,
                                height: 28,
                                style: [background(#475569), foreground(#F8FAFC), font_size(12), radius(5)],
                            )
                        }
                    }
                }
                Scroll(
                    id: body,
                    x: 18,
                    y: (((root.width < 680) ? 174 : 140) + 36),
                    width: card.width - 36,
                    height: card.height -(((root.width < 680) ? 174 : 140) + 36) - 60,
                    persistent: true,
                    style: [background(#E2E8F0)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for index, item in app.rows key item.key {
                            View(
                                x: 0,
                                y: index * 32,
                                width: (root.width - 68),
                                height: 31,
                                style: [background(item.selected ? #DBEAFE : item.stripe)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Button(
                                        text: item.number,
                                        on_click: app.select_row(item.id),
                                        x: 4,
                                        y: 3,
                                        width: 48,
                                        height: 25,
                                        style: [background(item.selected ? #2563EB : #E2E8F0), foreground(item.selected ? #FFFFFF : #334155), font_size(11), radius(5)],
                                    )
                                    Label(
                                        text: item.v1,
                                        x: 66,
                                        y: 7,
                                        width: ((root.width - 124) / 5) - 16,
                                        height: 18,
                                        style: [foreground(#0F172A), font_size(12)],
                                    )
                                    Label(
                                        text: item.v2,
                                        x: 66 +((root.width - 124) / 5),
                                        y: 7,
                                        width: ((root.width - 124) / 5) - 16,
                                        height: 18,
                                        style: [foreground(#0F172A), font_size(12)],
                                    )
                                    Label(
                                        text: item.sex,
                                        x: 66 + 2 *((root.width - 124) / 5),
                                        y: 7,
                                        width: ((root.width - 124) / 5) - 16,
                                        height: 18,
                                        style: [foreground(#1D4ED8), font_size(12)],
                                    )
                                    Label(
                                        text: item.worker,
                                        x: 66 + 3 *((root.width - 124) / 5),
                                        y: 7,
                                        width: ((root.width - 124) / 5) - 16,
                                        height: 18,
                                        style: [foreground(item.worker == "yes" ? #15803D : #B91C1C), font_size(12)],
                                    )
                                    Label(
                                        text: item.csp,
                                        x: 66 + 4 *((root.width - 124) / 5),
                                        y: 7,
                                        width: ((root.width - 124) / 5) - 16,
                                        height: 18,
                                        style: [foreground(#7C3AED), font_size(12)],
                                    )
                                }
                            }
                        }
                    }
                }
                Label(
                    id: grid2_status,
                    text: app.status,
                    x: 18,
                    y: card.height - 44,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
