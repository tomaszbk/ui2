Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Resizable menu window",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Toggle fixed menu width and invoke native context-menu actions.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Checkbox(
                    id: "compact",
                    text: "Compact menu width",
                    bind.checked: app.compact,
                    x: 18,
                    y: 76,
                    width: card.width - 36,
                    height: 30,
                    style: [foreground(#334155), font_size(13)],
                )
                View(
                    id: "menu_stage",
                    x: 18,
                    y: 120,
                    width: card.width - 36,
                    height: 112,
                    style: [background(#FEE2E2), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Button(
                            id: "actions",
                            text: "Actions",
                            on_click: app.open_actions(),
                            native: true,
                            x: 14,
                            y: 16,
                            width: app.compact ? 190 : menu_stage.width - 28,
                            height: 36,
                        ) {
                            MenuItem(id: "delete_developers", text: "Delete all developers", on_click: app.delete_developers())
                            MenuItem(id: "delete_users", text: "Delete users", on_click: app.delete_users())
                            MenuItem(id: "export_users", text: "Export users", on_click: app.export_users())
                            MenuItem(id: "exit_selected", text: "Exit", on_click: app.exit_selected())
                        }
                        Button(
                            id: "add_user",
                            text: "Add user",
                            on_click: app.add_user(),
                            native: true,
                            x: 14,
                            y: 62,
                            width: menu_stage.width - 28,
                            height: 36,
                        )
                    }
                }
                View(
                    x: 18,
                    y: 246,
                    width: card.width - 36,
                    height: 48,
                    style: [background(#DCFCE7), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            id: "menu_status",
                            text: app.status,
                            x: 10,
                            y: 14,
                            width: card.width - 56,
                            height: 20,
                            style: [text_align(center), foreground(#166534), font_size(12)],
                        )
                    }
                }
            }
        }
    }
}
