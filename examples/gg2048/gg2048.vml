Screen(
    id: "root",
    background: #FAF8EF,
) {
    Absolute(
        transparent: true,
    ) {
        Label(
            text: "2048",
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 18,
            width: 150,
            height: 50,
            color: #776E65,
            font_size: 36,
            bold: true,
        )
        View(
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2) +(root.width - 48 < 440 ? root.width - 48 : 440) - 150,
            y: 20,
            width: 150,
            height: 48,
            background: #BBADA0,
            corner_radius: 7,
        ) {
            Absolute(
                transparent: true,
            ) {
                Label(
                    text: "SCORE",
                    x: 8,
                    y: 4,
                    width: 134,
                    height: 16,
                    align: center,
                    color: #EEE4DA,
                    font_size: 10,
                    bold: true,
                )
                Label(
                    id: "score",
                    text: "${app.score}",
                    x: 8,
                    y: 19,
                    width: 134,
                    height: 24,
                    align: center,
                    color: #FFFFFF,
                    font_size: 17,
                    bold: true,
                )
            }
        }
        View(
            id: "board",
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 82,
            width: (root.width - 48 < 440 ? root.width - 48 : 440),
            height: (root.width - 48 < 440 ? root.width - 48 : 440),
            background: #BBADA0,
            corner_radius: 10,
        ) {
            Absolute(
                transparent: true,
            ) {
                Repeater(
                    model: app.cells,
                    key: item.key,
                ) {
                    View(
                        x: 10 + item.column *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        y: 10 + item.row *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        background: #CDC1B4,
                        corner_radius: 7,
                    )
                }
                Repeater(
                    model: app.tiles,
                    key: item.key,
                ) {
                    View(
                        x: 10 + item.column *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        y: 10 + item.row *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        background: item.color,
                        corner_radius: 7,
                    ) {
                        Absolute(
                            transparent: true,
                        ) {
                            Label(
                                text: "${item.value}",
                                x: 4,
                                y: 0,
                                width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) - 8,
                                height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                                align: center,
                                color: item.text_color,
                                font_size: item.value > 512 ? 18 : item.value > 64 ? 22 : 28,
                                bold: true,
                            )
                        }
                    }
                }
            }
        }
        Button(
            id: "move_up",
            text: "↑",
            on_tap: app.move_up(),
            native: true,
            x: root.width / 2 - 42,
            y: 536,
            width: 84,
            height: 34,
        )
        Button(
            id: "move_left",
            text: "←",
            on_tap: app.move_left(),
            native: true,
            x: root.width / 2 - 132,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: "move_down",
            text: "↓",
            on_tap: app.move_down(),
            native: true,
            x: root.width / 2 - 42,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: "move_right",
            text: "→",
            on_tap: app.move_right(),
            native: true,
            x: root.width / 2 + 48,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: "new_game",
            text: "New game",
            on_tap: app.new_game(),
            native: true,
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2) +(root.width - 48 < 440 ? root.width - 48 : 440) - 110,
            y: 622,
            width: 110,
            height: 34,
        )
        Label(
            id: "game_status",
            text: app.status,
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 626,
            width: (root.width - 48 < 440 ? root.width - 48 : 440) - 126,
            height: 22,
            color: #776E65,
            font_size: 11,
        )
    }
}
