Screen(
    id: root,
    style: [background(#FAF8EF)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "2048",
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 18,
            width: 150,
            height: 50,
            style: [foreground(#776E65), font_size(36), weight(700)],
        )
        View(
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2) +(root.width - 48 < 440 ? root.width - 48 : 440) - 150,
            y: 20,
            width: 150,
            height: 48,
            style: [background(#BBADA0), radius(7)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "SCORE",
                    x: 8,
                    y: 4,
                    width: 134,
                    height: 16,
                    style: [text_align(center), foreground(#EEE4DA), font_size(10), weight(700)],
                )
                Label(
                    id: score,
                    text: "${app.score}",
                    x: 8,
                    y: 19,
                    width: 134,
                    height: 24,
                    style: [text_align(center), foreground(#FFFFFF), font_size(17), weight(700)],
                )
            }
        }
        View(
            id: board,
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 82,
            width: (root.width - 48 < 440 ? root.width - 48 : 440),
            height: (root.width - 48 < 440 ? root.width - 48 : 440),
            style: [background(#BBADA0), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                for item in app.cells key item.key {
                    View(
                        x: 10 + item.column *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        y: 10 + item.row *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        style: [background(#CDC1B4), radius(7)],
                    )
                }
                for item in app.tiles key item.key {
                    View(
                        x: 10 + item.column *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        y: 10 + item.row *((((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) + 10),
                        width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                        style: [background(item.color), radius(7)],
                    ) {
                        Absolute(
                            style: [transparent(true)],
                        ) {
                            Label(
                                text: "${item.value}",
                                x: 4,
                                y: 0,
                                width: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4) - 8,
                                height: (((root.width - 48 < 440 ? root.width - 48 : 440) - 50) / 4),
                                style: [text_align(center), foreground(item.text_color), font_size(item.value > 512 ? 18 : item.value > 64 ? 22 : 28), weight(700)],
                            )
                        }
                    }
                }
            }
        }
        Button(
            id: move_up,
            text: "↑",
            on_click: app.move_up(),
            native: true,
            x: root.width / 2 - 42,
            y: 536,
            width: 84,
            height: 34,
        )
        Button(
            id: move_left,
            text: "←",
            on_click: app.move_left(),
            native: true,
            x: root.width / 2 - 132,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: move_down,
            text: "↓",
            on_click: app.move_down(),
            native: true,
            x: root.width / 2 - 42,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: move_right,
            text: "→",
            on_click: app.move_right(),
            native: true,
            x: root.width / 2 + 48,
            y: 576,
            width: 84,
            height: 34,
        )
        Button(
            id: new_game,
            text: "New game",
            on_click: app.new_game(),
            native: true,
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2) +(root.width - 48 < 440 ? root.width - 48 : 440) - 110,
            y: 622,
            width: 110,
            height: 34,
        )
        Label(
            id: game_status,
            text: app.status,
            x: ((root.width -(root.width - 48 < 440 ? root.width - 48 : 440)) / 2),
            y: 626,
            width: (root.width - 48 < 440 ? root.width - 48 : 440) - 126,
            height: 22,
            style: [foreground(#776E65), font_size(11)],
        )
    }
}
