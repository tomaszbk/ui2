Screen(
    id: "root",
    style: [background(#F2F5FA)],
) {
    Scroll(
        id: "viewport",
        style: [background(#F2F5FA)],
    ) {
        Absolute(
            style: [transparent(true)],
        ) {
            Flex(
                id: "page",
                width: root.width,
                height: root.height < 740 ? 740 : root.height,
                orientation: vertical,
                gap: 20,
                style: [padding(24), background(#F2F5FA)],
            ) {
                Flex(
                    id: "toolbar",
                    gap: 12,
                    line_gap: 12,
                    wrap: true,
                    align_items: center,
                    style: [transparent(true)],
                ) {
                    Label(text: "UI2 Studio", flex_grow: 1, min_width: 170, style: [font_size(26), weight(700), foreground(#17243D)])
                    Button(
                        id: "create",
                        text: "New project",
                        on_click: app.create_project(),
                        style: [background(#315EEB), foreground(#FFFFFF), radius(8)],
                    )
                    Button(id: "settings", text: "Settings", style: [background(#FFFFFF), foreground(#17243D), radius(8)])
                }
                Flex(
                    id: "searchbar",
                    gap: 12,
                    wrap: true,
                    align_items: center,
                    style: [transparent(true)],
                ) {
                    TextInput(
                        id: "search",
                        placeholder: "Search projects",
                        width: 220,
                        height: 38,
                        flex_grow: 1,
                        min_width: 150,
                        style: [background(#FFFFFF), radius(8)],
                    )
                    Label(id: "count", text: "Created: ${app.created}", style: [foreground(#52627D)])
                }
                Grid(
                    id: "projects",
                    flex_grow: 1,
                    auto_columns_min_width: 240,
                    max_columns: 3,
                    spacing: 16,
                    style: [transparent(true)],
                ) {
                    Flex(
                        id: "featured",
                        column_span: 2,
                        orientation: vertical,
                        gap: 10,
                        style: [padding(20), background(#17243D), radius(14)],
                    ) {
                        Label(text: "A layout that adapts", height: 30, style: [font_size(23), weight(700), foreground(#FFFFFF)])
                        Label(text: "Flex, grid and content sizing.", height: 24, style: [foreground(#C8D7F3)])
                        View(flex_grow: 1, style: [transparent(true)])
                        Flex(
                            justify: end,
                            style: [transparent(true)],
                        ) {
                            Button(
                                text: "Create project",
                                on_click: app.create_project(),
                                style: [background(#FFFFFF), foreground(#17243D), radius(8)],
                            )
                        }
                    }
                    Repeater(
                        model: app.projects,
                        key: item.id,
                    ) {
                        Flex(
                            orientation: vertical,
                            gap: 10,
                            style: [padding(20), background(#FFFFFF), radius(14)],
                        ) {
                            Label(text: item.title, height: 26, style: [font_size(20), weight(700), foreground(#17243D)])
                            Label(text: item.description, height: 24, style: [foreground(#52627D)])
                            View(flex_grow: 1, style: [transparent(true)])
                            Flex(
                                justify: end,
                                style: [transparent(true)],
                            ) {
                                Button(text: "Open project", style: [background(#E9EFFD), foreground(#244ECA), radius(8)])
                            }
                        }
                    }
                }
                Label(text: "Resize the window. Your search stays in place.", height: 20, style: [foreground(#52627D), font_size(12)])
            }
        }
    }
}
