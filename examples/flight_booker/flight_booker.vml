Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Flex(
        justify: center,
        align_items: start,
        style: [padding(16), transparent(true)],
    ) {
        Column(
            id: card,
            width: 368,
            max_width: 368,
            height: 358,
            gap: 10,
            style: [padding(16), background(#FFFFFF), radius(10)],
        ) {
            Label(text: "Book a flight", height: 28, style: [foreground(#111827), font_size(20), weight(700)])
            Dropdown(
                id: flight_type,
                bind.text: app.flight_type,
                on_change: app.flight_type_changed(),
                height: 40,
                style: [background(#F8FAFC), foreground(#111827), radius(7)],
            ) {
                Option(text: "one-way flight")
                Option(text: "return flight")
            }
            Column(
                gap: 4,
                style: [transparent(true)],
            ) {
                Label(text: "Departure(DD.MM.YYYY)", height: 18, style: [foreground(#475569), font_size(12)])
                TextInput(
                    id: departure,
                    bind.text: app.departure,
                    on_change: app.validate_departure(),
                    height: 28,
                    style: [background(app.departure_valid ? #F8FAFC : #FED7AA), foreground(#111827), radius(7)],
                )
            }
            Column(
                gap: 4,
                style: [transparent(true)],
            ) {
                Label(
                    text: "Return(DD.MM.YYYY)",
                    height: 18,
                    style: [foreground((app.flight_type == "return flight") ? #475569 : #94A3B8), font_size(12)],
                )
                TextInput(
                    id: return_date,
                    bind.text: app.return_date,
                    on_change: app.validate_return(),
                    enabled: (app.flight_type == "return flight"),
                    height: 28,
                    style: [background(app.return_valid ? #F8FAFC : #FED7AA), foreground(#111827), radius(7)],
                )
            }
            View(height: 12, style: [transparent(true)])
            Button(
                id: book,
                text: "Book",
                on_click: app.book(),
                native: true,
                enabled: (app.departure_valid &&(!(app.flight_type == "return flight") || app.return_valid)),
                height: 40,
                style: [background((app.departure_valid &&(!(app.flight_type == "return flight") || app.return_valid)) ? #3478D4 : #CBD5E1), foreground(#FFFFFF), weight(700), text_align(center), radius(7)],
            )
            Label(
                id: confirmation,
                text: app.confirmation,
                hidden: app.confirmation.len == 0,
                height: 34,
                style: [foreground(#166534), font_size(13), lines(2)],
            )
        }
    }
}
