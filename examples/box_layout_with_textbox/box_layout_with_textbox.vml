Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Box layout with a text box",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Fixed, stretched, percentage-anchored, and nested content.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                View(
                    id: "canvas",
                    x: 18,
                    y: 74,
                    width: card.width - 36,
                    height: card.height - 132,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(id: "fixed_red", x: 0, y: 0, width: 58, height: 58, style: [background(#FF6464), radius(7)])
                        View(
                            id: "stretched_green",
                            x: 58,
                            y: 58,
                            width: canvas.width - 88,
                            height: canvas.height - 88,
                            style: [background(#BBF7D0), radius(8)],
                        )
                        TextArea(
                            id: "notes",
                            bind.text: app.text,
                            on_change: app.text_changed(),
                            x: canvas.width / 2,
                            y: canvas.height / 2,
                            width: canvas.width / 2,
                            height: canvas.height / 2,
                            style: [background(#FEF3C7), foreground(#713F12), font_size(12), radius(7)],
                        )
                        View(
                            id: "corner_anchor",
                            x: canvas.width - 58,
                            y: canvas.height - 58,
                            width: 58,
                            height: 58,
                            style: [background(#FFFFFF), radius(7)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                View(
                                    id: "nested_anchor",
                                    x: 10,
                                    y: 10,
                                    width: 38,
                                    height: 38,
                                    style: [background(#334155), radius(6)],
                                )
                            }
                        }
                        Button(
                            id: "show_message",
                            text: "Show message",
                            on_click: app.show_message(),
                            native: true,
                            x: canvas.width * 0.68,
                            y: 18,
                            width: canvas.width * 0.28,
                            height: 36,
                        )
                    }
                }
                Label(
                    id: "status",
                    text: app.status,
                    x: 18,
                    y: card.height - 42,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
