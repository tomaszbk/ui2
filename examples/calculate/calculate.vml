Screen(
    id: "root",
    background: #F1F5F9,
) {
    Column(
        padding: 16,
        transparent: true,
    ) {
        Column(
            id: "card",
            flex_grow: 1,
            padding: 18,
            gap: 12,
            background: #FFFFFF,
            corner_radius: 10,
        ) {
            Label(text: "Expression calculator", height: 28, color: #111827, font_size: 18, bold: true)
            Label(text: "Enter arithmetic with parentheses, decimals, and + − × ÷.", height: 20, color: #64748B, font_size: 12)
            Row(
                height: 40,
                gap: 12,
                align_items: center,
                transparent: true,
            ) {
                TextInput(
                    id: "expression",
                    bind.text: app.expression,
                    on_submit: app.evaluate(),
                    flex_grow: 1,
                    height: 40,
                    background: #F8FAFC,
                    corner_radius: 7,
                    font_family: "Courier New",
                    font_size: 14,
                )
                Button(id: "evaluate", text: "Evaluate", on_tap: app.evaluate(), native: true, width: 100, height: 34)
            }
            Column(
                height: 88,
                padding: 14,
                gap: 3,
                background: app.has_error ? #FEE2E2 : #DCFCE7,
                corner_radius: 8,
            ) {
                Label(text: "Result", height: 18, align: center, color: app.has_error ? #991B1B : #166534, font_size: 11)
                Label(
                    id: "result",
                    text: app.result,
                    height: 40,
                    align: center,
                    color: app.has_error ? #991B1B : #14532D,
                    font_family: "Courier New",
                    font_size: 24,
                    bold: true,
                )
            }
            Row(
                height: 34,
                gap: 8,
                align_items: center,
                transparent: true,
            ) {
                Label(text: "Examples", width: 66, height: 20, color: #475569, font_size: 11)
                Button(text: "33.3 ÷ 4 − 3", on_tap: app.load_example(0), native: true, flex_basis: 0, flex_grow: 1, height: 34)
                Button(text: "3 + 22 ÷ 2", on_tap: app.load_example(1), native: true, flex_basis: 0, flex_grow: 1, height: 34)
                Button(text: "Nested", on_tap: app.load_example(2), native: true, flex_basis: 0, flex_grow: 1, height: 34)
            }
            View(flex_grow: 1, transparent: true)
            Label(
                id: "calculation_status",
                text: app.status,
                height: 18,
                align: center,
                color: app.has_error ? #B91C1C : #166534,
                font_size: 11,
            )
        }
    }
}
