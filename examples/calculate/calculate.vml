Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Column(
        style: [padding(16), transparent(true)],
    ) {
        Column(
            id: card,
            flex_grow: 1,
            gap: 12,
            style: [padding(18), background(#FFFFFF), radius(10)],
        ) {
            Label(text: "Expression calculator", height: 28, style: [foreground(#111827), font_size(18), weight(700)])
            Label(text: "Enter arithmetic with parentheses, decimals, and + − × ÷.", height: 20, style: [foreground(#64748B), font_size(12)])
            Row(
                height: 40,
                gap: 12,
                align_items: center,
                style: [transparent(true)],
            ) {
                TextInput(
                    id: expression,
                    bind.text: app.expression,
                    on_submit: app.evaluate(),
                    flex_grow: 1,
                    height: 40,
                    style: [background(#F8FAFC), radius(7), font_family("Courier New"), font_size(14)],
                )
                Button(id: evaluate, text: "Evaluate", on_click: app.evaluate(), native: true, width: 100, height: 34)
            }
            Column(
                height: 88,
                gap: 3,
                style: [padding(14), background(app.has_error ? #FEE2E2 : #DCFCE7), radius(8)],
            ) {
                Label(text: "Result", height: 18, style: [text_align(center), foreground(app.has_error ? #991B1B : #166534), font_size(11)])
                Label(
                    id: result,
                    text: app.result,
                    height: 40,
                    style: [text_align(center), foreground(app.has_error ? #991B1B : #14532D), font_family("Courier New"), font_size(24), weight(700)],
                )
            }
            Row(
                height: 34,
                gap: 8,
                align_items: center,
                style: [transparent(true)],
            ) {
                Label(text: "Examples", width: 66, height: 20, style: [foreground(#475569), font_size(11)])
                Button(text: "33.3 ÷ 4 − 3", on_click: app.load_example(0), native: true, flex_basis: 0, flex_grow: 1, height: 34)
                Button(text: "3 + 22 ÷ 2", on_click: app.load_example(1), native: true, flex_basis: 0, flex_grow: 1, height: 34)
                Button(text: "Nested", on_click: app.load_example(2), native: true, flex_basis: 0, flex_grow: 1, height: 34)
            }
            View(flex_grow: 1, style: [transparent(true)])
            Label(
                id: calculation_status,
                text: app.status,
                height: 18,
                style: [text_align(center), foreground(app.has_error ? #B91C1C : #166534), font_size(11)],
            )
        }
    }
}
