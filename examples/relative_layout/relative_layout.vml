Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Parent-local coordinates",
            x: 20,
            y: 16,
            width: root.width - 40,
            height: 30,
            style: [foreground(#0F172A), font_size(20), weight(700)],
        )
        Absolute(
            id: "panel",
            x: 70,
            y: 64,
            width: 260,
            height: 150,
            style: [background(#FFFFFF), radius(12)],
        ) {
            View(x: 16, y: 18, width: 88, height: 44, style: [background(#DBEAFE), radius(8)])
            Button(
                id: "centered_action",
                text: "Centered",
                width: 110,
                height: 38,
                x: (panel.width - 110) / 2,
                y: panel.height * 0.6 - 19,
                style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
            )
        }
    }
}
