Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Dropped files",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    id: drop_status,
                    text: app.status,
                    x: 18,
                    y: 43,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Scroll(
                    id: file_list,
                    x: 18,
                    y: 76,
                    width: card.width - 36,
                    height: card.height - 94,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for index, item in app.files key item.id {
                            View(
                                x: 8,
                                y: 8 + index * 58,
                                width: file_list.width - 32,
                                height: 50,
                                style: [background(index % 2 == 0 ? #FFFFFF : #F1F5F9), radius(7)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Label(
                                        text: item.name,
                                        x: 12,
                                        y: 7,
                                        width: file_list.width - 64,
                                        height: 20,
                                        style: [foreground(#1E293B), font_size(13), weight(700)],
                                    )
                                    Label(
                                        text: item.path,
                                        x: 12,
                                        y: 27,
                                        width: file_list.width - 64,
                                        height: 17,
                                        style: [foreground(#64748B), font_size(10)],
                                    )
                                }
                            }
                        }
                        Label(
                            id: empty_hint,
                            hidden: app.files.len > 0,
                            text: "Drag files here",
                            x: 20,
                            y: (file_list.height - 24) / 2,
                            width: file_list.width - 40,
                            height: 24,
                            style: [text_align(center), foreground(#94A3B8), font_size(15)],
                        )
                    }
                }
            }
        }
    }
}
