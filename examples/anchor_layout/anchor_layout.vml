Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Anchored controls",
            x: 20,
            y: 16,
            width: root.width - 40,
            height: 32,
            style: [foreground(#0F172A), font_size(22), weight(700)],
        )
        Stack(
            id: top_left,
            x: 20,
            y: 60,
            width: 160,
            height: 100,
            align_x: start,
            align_y: start,
            style: [padding(10), background(#FFFFFF), radius(8)],
        ) {
            Button(text: "Top left", width: 88, height: 34, style: [background(#DBEAFE)])
        }
        Stack(
            align_x: center,
            align_y: center,
            id: centered,
            x: 200,
            y: 60,
            width: 160,
            height: 100,
            style: [background(#FFFFFF), radius(8)],
        ) {
            Button(text: "Centered", width: 88, height: 34, style: [background(#DCFCE7)])
        }
        Stack(
            id: bottom_right,
            x: 20,
            y: 180,
            width: root.width - 40,
            height: 100,
            align_x: end,
            align_y: end,
            style: [padding(10), background(#FFFFFF), radius(8)],
        ) {
            Button(text: "Bottom right", width: 112, height: 34, style: [background(#FCE7F3)])
        }
    }
}
