Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: (root.width - 32),
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Textbox Demo",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 24,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                TextInput(
                    id: "title",
                    bind.text: app.title,
                    placeholder: "Document title",
                    x: 16,
                    y: 50,
                    width: card.width - 32,
                    height: 28,
                    style: [background(#F8FAFC), radius(7)],
                )
                Label(text: "Editable", x: 16, y: 94, width: (((root.width - 32) - 48) / 2), height: 18, style: [foreground(#475569)])
                Label(
                    text: "Read-only preview",
                    x: 32 +(((root.width - 32) - 48) / 2),
                    y: 94,
                    width: (((root.width - 32) - 48) / 2),
                    height: 18,
                    style: [foreground(#475569)],
                )
                TextArea(
                    id: "notes",
                    bind.text: app.notes,
                    on_change: app.update_status(),
                    x: 16,
                    y: 116,
                    width: (((root.width - 32) - 48) / 2),
                    height: card.height - 176,
                    style: [background(#FCF4E4), foreground(#111827), font_size(15), radius(7)],
                )
                TextArea(
                    id: "preview",
                    text: app.notes,
                    readonly: true,
                    hidden: ! app.show_preview,
                    x: 32 +(((root.width - 32) - 48) / 2),
                    y: 116,
                    width: (((root.width - 32) - 48) / 2),
                    height: card.height - 176,
                    style: [background(#F8FAFC), foreground(#334155), font_size(15), radius(7)],
                )
                Checkbox(
                    id: "show_preview",
                    text: "Show preview",
                    bind.checked: app.show_preview,
                    x: 16,
                    y: card.height - 48,
                    width: 150,
                    height: 24,
                )
                Label(
                    id: "status",
                    text: app.status,
                    x: 174,
                    y: card.height - 45,
                    width: card.width - 296,
                    height: 18,
                    style: [foreground(#64748B), font_size(13), text_align(center)],
                )
                Button(
                    id: "clear",
                    text: "Clear",
                    on_click: app.clear(),
                    native: true,
                    x: card.width - 106,
                    y: card.height - 52,
                    width: 90,
                    height: 32,
                    style: [background(#E2E8F0), radius(7)],
                )
            }
        }
    }
}
