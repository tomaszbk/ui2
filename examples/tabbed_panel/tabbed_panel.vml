Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(text: "Settings", x: 20, y: 14, width: root.width - 40, height: 30, style: [foreground(#0F172A), font_size(20), weight(700)])
        TabbedPanel(
            id: "settings",
            x: 20,
            y: 56,
            width: root.width - 40,
            height: 220,
            current: app.current,
            tab_width: 118,
            tab_height: 40,
            tab_background: #E2E8F0,
            active_tab_background: #FFFFFF,
            tab_color: #475569,
            active_tab_color: #1D4ED8,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Tab(
                id: "overview",
                text: "Overview",
                on_select: app.show_overview(),
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Account overview",
                        x: 24,
                        y: 30,
                        width: 300,
                        height: 32,
                        style: [foreground(#0F172A), font_size(22), weight(700)],
                    )
                    Label(text: "Reusable content for the active tab.", x: 24, y: 70, width: 330, height: 24, style: [foreground(#64748B)])
                }
            }
            Tab(
                id: "activity",
                text: "Activity",
                on_select: app.show_activity(),
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Recent activity",
                        x: 24,
                        y: 30,
                        width: 300,
                        height: 32,
                        style: [foreground(#14532D), font_size(22), weight(700)],
                    )
                }
            }
            Tab(
                id: "security",
                text: "Security",
                on_select: app.show_security(),
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Security options",
                        x: 24,
                        y: 30,
                        width: 300,
                        height: 32,
                        style: [foreground(#7C2D12), font_size(22), weight(700)],
                    )
                }
            }
        }
    }
}
