Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Fixed and proportional sizing",
            x: 20,
            y: 18,
            width: root.width - 40,
            height: 30,
            style: [foreground(#0F172A), font_size(20), weight(700)],
        )
        Flex(
            id: "actions",
            x: 20,
            y: 68,
            width: root.width - 40,
            height: 96,
            gap: 8,
            style: [padding(10), background(#FFFFFF), radius(10)],
        ) {
            Button(text: "Fixed", width: 88, flex_shrink: 0, style: [background(#E2E8F0), radius(6)])
            Button(text: "2 shares", flex_basis: 0, flex_grow: 2, style: [background(#BFDBFE), radius(6)])
            Button(text: "1 share", flex_basis: 0, flex_grow: 1, style: [background(#DBEAFE), radius(6)])
        }
    }
}
