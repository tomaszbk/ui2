Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Editor", x: 18, y: 14, width: 100, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Checkbox(
                    id: sidebar_open,
                    text: "Files",
                    bind.checked: app.sidebar_open,
                    x: 126,
                    y: 14,
                    width: 76,
                    height: 30,
                    style: [foreground(#334155), font_size(11)],
                )
                Label(
                    text: app.current_name.len > 0 ?(app.dirty ? "${app.current_name} •" : app.current_name) : "No file open",
                    x: 212,
                    y: 18,
                    width: card.width - 462,
                    height: 20,
                    style: [text_align(center), foreground(app.dirty ? #B45309 : #64748B), font_size(11)],
                )
                TextInput(
                    id: new_name,
                    bind.text: app.new_name,
                    on_submit: app.create_file(),
                    placeholder: "new_file.v",
                    x: card.width - 242,
                    y: 12,
                    width: 128,
                    height: 36,
                    style: [background(#F8FAFC), radius(7), font_size(11)],
                )
                Button(
                    id: create_file,
                    text: "New",
                    on_click: app.create_file(),
                    native: true,
                    x: card.width - 108,
                    y: 13,
                    width: 42,
                    height: 34,
                )
                Button(
                    id: save_file,
                    text: "Save",
                    on_click: app.save_file(),
                    enabled: app.current_path.len > 0,
                    native: true,
                    x: card.width - 60,
                    y: 13,
                    width: 42,
                    height: 34,
                )
                View(
                    id: file_panel,
                    hidden: ! app.sidebar_open,
                    x: 18,
                    y: 62,
                    width: 190,
                    height: card.height - 118,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: app.root_path,
                            x: 10,
                            y: 8,
                            width: file_panel.width - 20,
                            height: 18,
                            style: [foreground(#64748B), font_size(9)],
                        )
                        Scroll(
                            id: editor_files,
                            x: 8,
                            y: 32,
                            width: file_panel.width - 16,
                            height: file_panel.height - 40,
                            style: [background(#F8FAFC)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                for index, item in app.files key item.path {
                                    Button(
                                        text: item.name,
                                        on_click: app.open_file(item.id),
                                        native: true,
                                        x: 2,
                                        y: index * 36,
                                        width: editor_files.width - 20,
                                        height: 30,
                                        style: [background(item.path == app.current_path ? #DBEAFE : #FFFFFF), font_size(10)],
                                    )
                                }
                            }
                        }
                    }
                }
                TextArea(
                    id: editor_text,
                    bind.text: app.text,
                    on_change: app.mark_dirty(),
                    x: app.sidebar_open ? 220 : 18,
                    y: 62,
                    width: app.sidebar_open ? card.width - 238 : card.width - 36,
                    height: card.height - 118,
                    style: [background(#FFFBEB), foreground(#1E293B), font_family("Courier New"), font_size(12), radius(8)],
                )
                Label(
                    id: editor_status,
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(app.dirty ? #B45309 : #166534), font_size(10)],
                )
            }
        }
    }
}
