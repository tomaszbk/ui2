Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Canvas layout inside a row",
                    x: 18,
                    y: 14,
                    width: 320,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Button(
                    id: "rotate",
                    text: "Rotate",
                    on_click: callback_rotate,
                    native: true,
                    x: card.width - 246,
                    y: 13,
                    width: 96,
                    height: 34,
                )
                Button(
                    id: "return",
                    text: "Return to tray",
                    on_click: callback_return,
                    native: true,
                    x: card.width - 142,
                    y: 13,
                    width: 124,
                    height: 34,
                )
                Label(
                    text: "The row gives each pane its own origin. Drag the logo across the divider and watch the same position read differently in each.",
                    x: 18,
                    y: 44,
                    width: card.width - 266,
                    height: 18,
                    style: [foreground(#64748B), font_size(11)],
                )
                View(
                    id: "tray",
                    x: 18,
                    y: 96,
                    width: 220,
                    height: card.height - 156,
                    style: [background(#E2E8F0), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(text: "Tray pane", x: 14, y: 12, width: 192, height: 18, style: [foreground(#334155), font_size(12), weight(700)])
                        Label(text: "origin(0, 0)", x: 14, y: 32, width: 192, height: 16, style: [foreground(#64748B), font_size(10)])
                        View(
                            x: 14,
                            y: tray.height - 54,
                            width: 192,
                            height: 40,
                            style: [background(#F8FAFC), radius(7)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "tray ${app.tray_text}",
                                    x: 0,
                                    y: 11,
                                    width: 192,
                                    height: 18,
                                    style: [text_align(center), foreground(app.over_canvas ? #94A3B8 : #1D4ED8), font_size(12), weight(700)],
                                )
                            }
                        }
                    }
                }
                View(
                    id: "canvas",
                    x: 250,
                    y: 96,
                    width: (root.width - 300),
                    height: card.height - 156,
                    style: [background(#F8FAFC), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Canvas pane",
                            x: 16,
                            y: 12,
                            width: 260,
                            height: 18,
                            style: [foreground(#334155), font_size(12), weight(700)],
                        )
                        Label(
                            text: "origin(0, 0), a different one",
                            x: 16,
                            y: 32,
                            width: 260,
                            height: 16,
                            style: [foreground(#64748B), font_size(10)],
                        )
                        View(x: 16, y: 60, width: 1, height: canvas.height - 130, style: [background(#CBD5E1)])
                        View(x: 16, y: 60, width: (root.width - 300) - 32, height: 1, style: [background(#CBD5E1)])
                        View(
                            x: 16,
                            y: canvas.height - 54,
                            width: 220,
                            height: 40,
                            style: [background(#FFFFFF), radius(7)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "canvas ${app.canvas_text}",
                                    x: 0,
                                    y: 11,
                                    width: 220,
                                    height: 18,
                                    style: [text_align(center), foreground(app.over_canvas ? #15803D : #94A3B8), font_size(12), weight(700)],
                                )
                            }
                        }
                    }
                }
                Image(
                    id: "logo",
                    source: app.logo_path,
                    on_pointer_down: callback_logo,
                    on_pointer_drag: callback_logo,
                    on_pointer_up: callback_logo,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    tooltip: "Drag me across the divider",
                    rotation: app.rotation,
                    origin_x: 36,
                    origin_y: 36,
                    x: app.logo_x,
                    y: app.logo_y,
                    width: 72,
                    height: 72,
                )
                Label(
                    id: "inside_row_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 42,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
