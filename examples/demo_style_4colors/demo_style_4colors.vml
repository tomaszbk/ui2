Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Four-color style",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Choose a coordinated base, surface, accent, and text palette.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Dropdown(
                    id: "palette",
                    bind.text: app.palette,
                    on_change: app.palette_changed(),
                    x: 18,
                    y: 72,
                    width: 180,
                    height: 38,
                    style: [background(#F1F5F9), foreground(#1E293B), radius(7)],
                ) {
                    Option(text: "Classic")
                    Option(text: "Ocean")
                    Option(text: "Sunset")
                    Option(text: "Forest")
                }
                View(
                    id: "swatch0",
                    x: 214,
                    y: 72,
                    width: (card.width - 250) / 4,
                    height: 38,
                    style: [background(#CBD5E1), radius(6)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: "color0",
                            x: 1,
                            y: 1,
                            width: swatch0.width - 2,
                            height: swatch0.height - 2,
                            style: [background(app.color0), radius(5)],
                        )
                    }
                }
                View(
                    id: "swatch1",
                    x: 222 +(card.width - 250) / 4,
                    y: 72,
                    width: (card.width - 250) / 4,
                    height: 38,
                    style: [background(#CBD5E1), radius(6)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: "color1",
                            x: 1,
                            y: 1,
                            width: swatch1.width - 2,
                            height: swatch1.height - 2,
                            style: [background(app.color1), radius(5)],
                        )
                    }
                }
                View(
                    id: "swatch2",
                    x: 230 +(card.width - 250) / 2,
                    y: 72,
                    width: (card.width - 250) / 4,
                    height: 38,
                    style: [background(#CBD5E1), radius(6)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: "color2",
                            x: 1,
                            y: 1,
                            width: swatch2.width - 2,
                            height: swatch2.height - 2,
                            style: [background(app.color2), radius(5)],
                        )
                    }
                }
                View(
                    id: "swatch3",
                    x: 238 +(card.width - 250) * 0.75,
                    y: 72,
                    width: (card.width - 250) / 4,
                    height: 38,
                    style: [background(#CBD5E1), radius(6)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: "color3",
                            x: 1,
                            y: 1,
                            width: swatch3.width - 2,
                            height: swatch3.height - 2,
                            style: [background(app.color3), radius(5)],
                        )
                    }
                }
                View(
                    id: "preview",
                    x: 18,
                    y: 132,
                    width: card.width - 36,
                    height: card.height - 202,
                    style: [background(app.color0), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 18,
                            y: 18,
                            width: preview.width - 36,
                            height: preview.height - 36,
                            style: [background(app.color1), radius(8)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "Styled preview",
                                    x: 16,
                                    y: 14,
                                    width: preview.width - 68,
                                    height: 26,
                                    style: [foreground(app.color3), font_size(17), weight(700)],
                                )
                                Label(
                                    text: "The four selected colors update this sample surface.",
                                    x: 16,
                                    y: 42,
                                    width: preview.width - 68,
                                    height: 20,
                                    style: [foreground(app.color3), font_size(12)],
                                )
                                Checkbox(
                                    id: "sample_enabled",
                                    text: "Example setting",
                                    bind.checked: app.enabled,
                                    x: 16,
                                    y: 76,
                                    width: 180,
                                    height: 30,
                                    style: [foreground(app.color3), font_size(13)],
                                )
                                Button(
                                    id: "apply_palette",
                                    text: "Apply palette",
                                    on_click: app.apply_palette(),
                                    native: true,
                                    x: preview.width - 180,
                                    y: preview.height - 86,
                                    width: 130,
                                    height: 36,
                                    style: [background(app.color2), foreground(app.color3)],
                                )
                            }
                        }
                    }
                }
                Label(
                    id: "palette_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 42,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
