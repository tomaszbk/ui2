Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Split panel", x: 18, y: 14, width: 150, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    id: split_status,
                    text: app.status,
                    x: 176,
                    y: 18,
                    width: card.width - 470,
                    height: 20,
                    style: [text_align(center), foreground(#64748B), font_size(11)],
                )
                Button(text: "Top −", on_click: app.top_less(), native: true, x: card.width - 282, y: 12, width: 60, height: 32)
                Button(text: "Top +", on_click: app.top_more(), native: true, x: card.width - 216, y: 12, width: 60, height: 32)
                Button(text: "Left −", on_click: app.left_less(), native: true, x: card.width - 150, y: 12, width: 60, height: 32)
                Button(text: "Left +", on_click: app.left_more(), native: true, x: card.width - 84, y: 12, width: 66, height: 32)
                Button(
                    id: reset_splits,
                    text: "Reset",
                    on_click: app.reset_splits(),
                    native: true,
                    x: 18,
                    y: 52,
                    width: 92,
                    height: 32,
                )
                View(
                    id: stage,
                    x: 18,
                    y: 94,
                    width: card.width - 36,
                    height: card.height - 112,
                    style: [background(#CBD5E1), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: top_panel,
                            x: 1,
                            y: 1,
                            width: stage.width - 2,
                            height: (stage.height - 10) * app.top_weight,
                            style: [background(#DCFCE7), radius(7)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "Top pane",
                                    x: 14,
                                    y: 12,
                                    width: top_panel.width - 28,
                                    height: 22,
                                    style: [foreground(#166534), font_size(15), weight(700)],
                                )
                                Label(
                                    text: "A responsive panel spanning the full width.",
                                    x: 14,
                                    y: 38,
                                    width: top_panel.width - 28,
                                    height: 20,
                                    style: [foreground(#15803D), font_size(11)],
                                )
                            }
                        }
                        View(
                            id: lower_panel,
                            x: 1,
                            y: (stage.height - 10) * app.top_weight + 9,
                            width: stage.width - 2,
                            height: stage.height -(stage.height - 10) * app.top_weight - 10,
                            style: [background(#CBD5E1)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                TextArea(
                                    id: split_notes,
                                    bind.text: app.notes,
                                    x: 0,
                                    y: 0,
                                    width: (lower_panel.width - 8) * app.left_weight,
                                    height: lower_panel.height,
                                    style: [background(#FEF3C7), foreground(#713F12), font_size(12), radius(7)],
                                )
                                Scroll(
                                    id: split_grid,
                                    x: (lower_panel.width - 8) * app.left_weight + 8,
                                    y: 0,
                                    width: lower_panel.width -(lower_panel.width - 8) * app.left_weight - 8,
                                    height: lower_panel.height,
                                    style: [background(#F8FAFC)],
                                ) {
                                    Absolute(
                                        style: [transparent(true)],
                                    ) {
                                        View(
                                            x: 0,
                                            y: 0,
                                            width: split_grid.width - 16,
                                            height: 32,
                                            style: [background(#334155)],
                                        ) {
                                            Absolute(
                                                style: [transparent(true)],
                                            ) {
                                                Label(
                                                    text: "Name",
                                                    x: 10,
                                                    y: 6,
                                                    width: (split_grid.width - 36) * 0.34,
                                                    height: 20,
                                                    style: [foreground(#FFFFFF), font_size(11), weight(700)],
                                                )
                                                Label(
                                                    text: "Role",
                                                    x: (split_grid.width - 36) * 0.34,
                                                    y: 6,
                                                    width: (split_grid.width - 36) * 0.38,
                                                    height: 20,
                                                    style: [foreground(#FFFFFF), font_size(11), weight(700)],
                                                )
                                                Label(
                                                    text: "Team",
                                                    x: (split_grid.width - 36) * 0.72,
                                                    y: 6,
                                                    width: (split_grid.width - 36) * 0.28,
                                                    height: 20,
                                                    style: [foreground(#FFFFFF), font_size(11), weight(700)],
                                                )
                                            }
                                        }
                                        for index, item in app.rows key item.id {
                                            View(
                                                x: 0,
                                                y: 34 + index * 34,
                                                width: split_grid.width - 16,
                                                height: 32,
                                                style: [background(index == 1 || index == 3 ? #F1F5F9 : #FFFFFF)],
                                            ) {
                                                Absolute(
                                                    style: [transparent(true)],
                                                ) {
                                                    Label(
                                                        text: item.name,
                                                        x: 10,
                                                        y: 6,
                                                        width: (split_grid.width - 36) * 0.34,
                                                        height: 20,
                                                        style: [foreground(#1E293B), font_size(11)],
                                                    )
                                                    Label(
                                                        text: item.role,
                                                        x: (split_grid.width - 36) * 0.34,
                                                        y: 6,
                                                        width: (split_grid.width - 36) * 0.38,
                                                        height: 20,
                                                        style: [foreground(#1E293B), font_size(11)],
                                                    )
                                                    Label(
                                                        text: item.team,
                                                        x: (split_grid.width - 36) * 0.72,
                                                        y: 6,
                                                        width: (split_grid.width - 36) * 0.28,
                                                        height: 20,
                                                        style: [foreground(#1E293B), font_size(11)],
                                                    )
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
