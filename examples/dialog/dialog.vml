Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Dialog",
            x: 20,
            y: 20,
            width: root.width - 40,
            height: 34,
            style: [text_align(center), foreground(#0F172A), font_size(24), weight(700)],
        )
        Label(text: app.status, x: 20, y: 76, width: root.width - 40, height: 26, style: [text_align(center), foreground(#475569)])
        Button(
            id: open_confirmation,
            text: "Open confirmation",
            on_click: app.open_confirmation(),
            x: (root.width - 170) / 2,
            y: 132,
            width: 170,
            height: 40,
            style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
        )
        Dialog(
            id: confirmation,
            width: 340,
            height: 190,
            open: app.confirming,
            on_dismiss: app.close_confirmation(),
            style: [background(#FFFFFF), radius(12)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    id: confirmation_title,
                    text: "Confirm action",
                    x: 24,
                    y: 24,
                    width: 292,
                    height: 30,
                    style: [text_align(center), foreground(#0F172A), font_size(20), weight(700)],
                )
                Label(
                    text: "Escape or the backdrop closes this dialog.",
                    x: 24,
                    y: 66,
                    width: 292,
                    height: 24,
                    style: [text_align(center), foreground(#64748B)],
                )
                Button(
                    id: cancel,
                    text: "Cancel",
                    on_click: app.close_confirmation(),
                    x: 46,
                    y: 126,
                    width: 110,
                    height: 38,
                    style: [background(#E2E8F0), foreground(#334155), radius(8)],
                )
                Button(
                    id: confirm,
                    text: "Confirm",
                    on_click: app.confirm(),
                    x: 184,
                    y: 126,
                    width: 110,
                    height: 38,
                    style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
                )
            }
        }
    }
}
