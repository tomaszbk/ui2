Screen(
    id: "root",
    background: #F1F5F9,
) {
    Absolute(
        transparent: true,
    ) {
        View(
            id: "card",
            x: ((root.width -(root.width - 32 < 348 ? root.width - 32 : 348)) / 2),
            y: 16,
            width: (root.width - 32 < 348 ? root.width - 32 : 348),
            height: 290,
            background: #FFFFFF,
            corner_radius: 10,
        ) {
            Absolute(
                transparent: true,
            ) {
                Label(
                    text: "RGB color",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 24,
                    color: #111827,
                    font_size: 18,
                    bold: true,
                )
                View(
                    id: "preview",
                    x: 16,
                    y: 50,
                    width: card.width - 32,
                    height: 100,
                    background: app.preview_color,
                    corner_radius: 8,
                ) {
                    Absolute(
                        transparent: true,
                    ) {
                        Label(
                            text: app.valid ? "" : "Invalid RGB value",
                            x: 8,
                            y: 41,
                            width: card.width - 48,
                            height: 18,
                            color: #991B1B,
                            font_size: 13,
                            bold: true,
                            align: center,
                        )
                    }
                }
                Label(
                    text: "R",
                    x: 16,
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    align: center,
                    color: #991B1B,
                )
                Label(
                    text: "G",
                    x: 32 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    align: center,
                    color: #166534,
                )
                Label(
                    text: "B",
                    x: 48 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3) * 2,
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    align: center,
                    color: #1E40AF,
                )
                TextInput(
                    id: "red",
                    bind.text: app.red,
                    on_change: app.update_color(),
                    x: 16,
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    background: app.valid ? #F8FAFC : #FEE2E2,
                    corner_radius: 7,
                )
                TextInput(
                    id: "green",
                    bind.text: app.green,
                    on_change: app.update_color(),
                    x: 32 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    background: app.valid ? #F8FAFC : #FEE2E2,
                    corner_radius: 7,
                )
                TextInput(
                    id: "blue",
                    bind.text: app.blue,
                    on_change: app.update_color(),
                    x: 48 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3) * 2,
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    background: app.valid ? #F8FAFC : #FEE2E2,
                    corner_radius: 7,
                )
                Button(
                    id: "show_color",
                    text: "Show RGB color",
                    on_tap: app.show_color(),
                    native: true,
                    x: 16,
                    y: 224,
                    width: card.width - 32,
                    height: 34,
                    background: #3478D4,
                    color: #FFFFFF,
                    corner_radius: 7,
                )
                Label(
                    id: "value",
                    text: app.message,
                    x: 16,
                    y: 266,
                    width: card.width - 32,
                    height: 18,
                    color: app.valid ? #166534 : #991B1B,
                    font_size: 13,
                    align: center,
                )
            }
        }
    }
}
