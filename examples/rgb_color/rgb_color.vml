Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: ((root.width -(root.width - 32 < 348 ? root.width - 32 : 348)) / 2),
            y: 16,
            width: (root.width - 32 < 348 ? root.width - 32 : 348),
            height: 290,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "RGB color",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 24,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                View(
                    id: "preview",
                    x: 16,
                    y: 50,
                    width: card.width - 32,
                    height: 100,
                    style: [background(app.preview_color), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: app.valid ? "" : "Invalid RGB value",
                            x: 8,
                            y: 41,
                            width: card.width - 48,
                            height: 18,
                            style: [foreground(#991B1B), font_size(13), weight(700), text_align(center)],
                        )
                    }
                }
                Label(
                    text: "R",
                    x: 16,
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    style: [text_align(center), foreground(#991B1B)],
                )
                Label(
                    text: "G",
                    x: 32 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    style: [text_align(center), foreground(#166534)],
                )
                Label(
                    text: "B",
                    x: 48 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3) * 2,
                    y: 164,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 18,
                    style: [text_align(center), foreground(#1E40AF)],
                )
                TextInput(
                    id: "red",
                    bind.text: app.red,
                    on_change: app.update_color(),
                    x: 16,
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    style: [background(app.valid ? #F8FAFC : #FEE2E2), radius(7)],
                )
                TextInput(
                    id: "green",
                    bind.text: app.green,
                    on_change: app.update_color(),
                    x: 32 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    style: [background(app.valid ? #F8FAFC : #FEE2E2), radius(7)],
                )
                TextInput(
                    id: "blue",
                    bind.text: app.blue,
                    on_change: app.update_color(),
                    x: 48 +(((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3) * 2,
                    y: 184,
                    width: (((root.width - 32 < 348 ? root.width - 32 : 348) - 64) / 3),
                    height: 28,
                    style: [background(app.valid ? #F8FAFC : #FEE2E2), radius(7)],
                )
                Button(
                    id: "show_color",
                    text: "Show RGB color",
                    on_click: app.show_color(),
                    native: true,
                    x: 16,
                    y: 224,
                    width: card.width - 32,
                    height: 34,
                    style: [background(#3478D4), foreground(#FFFFFF), radius(7)],
                )
                Label(
                    id: "value",
                    text: app.message,
                    x: 16,
                    y: 266,
                    width: card.width - 32,
                    height: 18,
                    style: [foreground(app.valid ? #166534 : #991B1B), font_size(13), text_align(center)],
                )
            }
        }
    }
}
