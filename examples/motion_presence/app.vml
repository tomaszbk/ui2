import MotionCard

Screen(id: "root", background: #F1F5F9) {
    Column(padding: 24, gap: 16) {
        Label(text: "Motion and presence", height: 36, font_size: 28, bold: true, color: #0F172A)
        Label(text: "Interrupt an exit to keep each card's counter and local edits.", height: 24, color: #475569)
        Row(gap: 8, height: 38) {
            Button(text: "Show / hide", flex_grow: 1, on_click: app.toggle_panel())
            Button(text: "Transform", flex_grow: 1, on_click: app.toggle_transform())
            Button(text: "Remove / restore", flex_grow: 1, on_click: app.toggle_cards())
            Button(text: "Reduced motion", flex_grow: 1, on_click: app.toggle_reduced())
        }
        Label(text: "Reduced motion: ${app.reduced}; completed card cleanups: ${app.cleaned}", height: 24, color: #166534)
        Column(id: "panel", hidden: !app.shown, motion: app.panel_motion(), translate_x: app.panel_x(), rotation: app.panel_rotation(), origin_x: 280, origin_y: 100, padding: 16, gap: 12, height: 240, background: #FFFFFF, corner_radius: 12) {
            Repeater(model: app.rows, key: item.id) {
                MotionCard(title: item.title)
            }
        }
    }
}
