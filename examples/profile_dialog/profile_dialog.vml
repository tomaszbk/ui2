Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Profile: ${app.name}",
            x: 20,
            y: 52,
            width: root.width - 40,
            height: 34,
            style: [text_align(center), foreground(#0F172A), font_size(22), weight(700)],
        )
        Button(
            id: "open_editor",
            text: "Edit profile",
            on_click: app.open_editor(),
            x: (root.width - 140) / 2,
            y: 116,
            width: 140,
            height: 40,
            style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
        )
        Dialog(
            id: "editor",
            width: 340,
            height: 260,
            open: app.editing,
            on_dismiss: app.close_editor(),
            style: [background(#FFFFFF), radius(12)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(id: "editor_title", text: "Edit profile", x: 24, y: 16, width: 292, height: 30,
                    style: [text_align(center), foreground(#0F172A), font_size(20), weight(700)])
                View(x: 0, y: 52, width: 340, height: 1, style: [background(#E2E8F0)])
                Label(text: "Display name", x: 24, y: 73, width: 292, height: 22, style: [foreground(#475569)])
                TextInput(
                    id: "name",
                    bind.text: app.name,
                    x: 24,
                    y: 101,
                    width: 292,
                    height: 38,
                    style: [background(#F8FAFC), radius(7)],
                )
                Button(
                    id: "cancel",
                    text: "Cancel",
                    on_click: app.close_editor(),
                    x: 46,
                    y: 184,
                    width: 110,
                    height: 38,
                    style: [background(#E2E8F0), foreground(#334155), radius(8)],
                )
                Button(
                    id: "save",
                    text: "Save",
                    on_click: app.save_editor(),
                    x: 184,
                    y: 184,
                    width: 110,
                    height: 38,
                    style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
                )
            }
        }
    }
}
