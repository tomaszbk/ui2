Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Nested clipping", x: 18, y: 14, width: 260, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: "clip_all",
                    text: "Clip all",
                    on_click: app.clip_all(),
                    native: true,
                    x: card.width - 226,
                    y: 13,
                    width: 100,
                    height: 34,
                )
                Button(
                    id: "clip_none",
                    text: "Clip none",
                    on_click: app.clip_none(),
                    native: true,
                    x: card.width - 118,
                    y: 13,
                    width: 100,
                    height: 34,
                )
                Label(
                    text: "Every box paints bars that reach past its own frame. A clipped box keeps them inside; an unclipped one spills over its neighbours until a later box paints on top.",
                    x: 18,
                    y: 44,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Button(
                    id: "quadrant1",
                    text: "Quadrant 1",
                    on_click: app.toggle_quadrant(1),
                    native: true,
                    x: 18,
                    y: 72,
                    width: 112,
                    height: 30,
                )
                Button(
                    id: "quadrant2",
                    text: "Quadrant 2",
                    on_click: app.toggle_quadrant(2),
                    native: true,
                    x: 138,
                    y: 72,
                    width: 112,
                    height: 30,
                )
                Button(
                    id: "quadrant3",
                    text: "Quadrant 3",
                    on_click: app.toggle_quadrant(3),
                    native: true,
                    x: 258,
                    y: 72,
                    width: 112,
                    height: 30,
                )
                Button(
                    id: "quadrant4",
                    text: "Quadrant 4",
                    on_click: app.toggle_quadrant(4),
                    native: true,
                    x: 378,
                    y: 72,
                    width: 112,
                    height: 30,
                )
                View(
                    id: "stage",
                    x: 18,
                    y: 114,
                    width: card.width - 36,
                    height: card.height - 174,
                    style: [background(#0F172A), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.boxes,
                            key: item.key,
                        ) {
                            View(
                                x: 10 + item.column *((root.width - 88) / 4),
                                y: 10 + item.row *((root.height - 226) / 4),
                                width: ((root.width - 88) / 4) - 10,
                                height: ((root.height - 226) / 4) - 10,
                                style: [background(#FFFFFF), radius(6)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Scroll(
                                        hidden: ! item.clipping,
                                        x: 0,
                                        y: 0,
                                        width: ((root.width - 88) / 4) - 10,
                                        height: ((root.height - 226) / 4) - 10,
                                        style: [background(#FFFFFF)],
                                    ) {
                                        Absolute(
                                            style: [transparent(true)],
                                        ) {
                                            View(
                                                x: - 70,
                                                y: 40,
                                                width: ((root.width - 88) / 4) + 130,
                                                height: 16,
                                                style: [background(item.color)],
                                            )
                                            View(
                                                x: ((root.width - 88) / 4) - 48,
                                                y: - 36,
                                                width: 16,
                                                height: ((root.height - 226) / 4) - 48,
                                                style: [background(item.color)],
                                            )
                                        }
                                    }
                                    View(
                                        hidden: item.clipping,
                                        x: - 70,
                                        y: 40,
                                        width: ((root.width - 88) / 4) + 130,
                                        height: 16,
                                        style: [background(item.color)],
                                    )
                                    View(
                                        hidden: item.clipping,
                                        x: ((root.width - 88) / 4) - 48,
                                        y: - 36,
                                        width: 16,
                                        height: ((root.height - 226) / 4) - 48,
                                        style: [background(item.color)],
                                    )
                                    Label(
                                        text: "drawn ${item.order}",
                                        x: 8,
                                        y: 4,
                                        width: ((root.width - 88) / 4) - 26,
                                        height: 16,
                                        style: [foreground(#0F172A), font_size(10)],
                                    )
                                    Label(
                                        text: item.clipping ? "clip: yes" : "clip: no",
                                        x: 8,
                                        y: 20,
                                        width: ((root.width - 88) / 4) - 26,
                                        height: 16,
                                        style: [foreground(#475569), font_size(10)],
                                    )
                                    Button(
                                        text: item.clipping ? "Unclip" : "Clip",
                                        on_click: app.toggle_box(item.id),
                                        native: true,
                                        x: 8,
                                        y: ((root.height - 226) / 4) - 44,
                                        width: 86,
                                        height: 28,
                                    )
                                }
                            }
                        }
                    }
                }
                Label(
                    id: "clip_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 42,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
