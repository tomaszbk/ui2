Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Message",
                    x: 16,
                    y: 14,
                    width: root.width - 64,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Native alerts block; the drawn one does not.",
                    x: 16,
                    y: 50,
                    width: root.width - 64,
                    height: 22,
                    style: [foreground(#64748B), font_size(13)],
                )
                Button(
                    id: "show_native_message",
                    text: "Show native message",
                    on_click: app.show_native_message(),
                    native: true,
                    x: 16,
                    y: 92,
                    width: root.width - 64,
                    height: 36,
                )
                Button(
                    id: "ask_native_question",
                    text: "Ask a native question",
                    on_click: app.ask_native_question(),
                    native: true,
                    x: 16,
                    y: 136,
                    width: root.width - 64,
                    height: 36,
                )
                Button(
                    id: "show_message",
                    text: "Show drawn message",
                    on_click: app.show_message(),
                    native: true,
                    x: 16,
                    y: 180,
                    width: root.width - 64,
                    height: 36,
                )
                Label(
                    id: "answer",
                    text: app.answer,
                    x: 16,
                    y: 228,
                    width: root.width - 64,
                    height: 22,
                    style: [foreground(#475569), font_size(13)],
                )
            }
        }
        MessageBox(
            id: "overlay",
            hidden: ! app.visible,
            title: "Hello World",
            text: "This message came from the ui example.",
            dialog_width: 360,
        ) {
            Button(id: "close_message", text: "OK", on_click: app.close_message())
        }
    }
}
