Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Gradient texture", x: 18, y: 14, width: 220, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: previous_hue,
                    text: "Previous",
                    on_click: app.previous_hue(),
                    native: true,
                    x: card.width - 220,
                    y: 13,
                    width: 92,
                    height: 34,
                )
                Button(
                    id: next_hue,
                    text: "Next",
                    on_click: app.next_hue(),
                    native: true,
                    x: card.width - 118,
                    y: 13,
                    width: 100,
                    height: 34,
                )
                View(
                    id: gradient,
                    x: 18,
                    y: 64,
                    width: card.width - 36,
                    height: card.height - 132,
                    style: [background(#111827), radius(0)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for item in app.cells key item.id {
                            View(
                                x: item.column * gradient.width / 20,
                                y: item.row * gradient.height / 14,
                                width: gradient.width / 20 + 1,
                                height: gradient.height / 14 + 1,
                                style: [background(item.color)],
                            )
                        }
                    }
                }
                View(x: 18, y: card.height - 50, width: 18, height: 18, style: [background(app.hue_color), radius(9)])
                Label(
                    text: app.status,
                    x: 46,
                    y: card.height - 52,
                    width: card.width - 64,
                    height: 22,
                    style: [foreground(#475569), font_size(11)],
                )
            }
        }
    }
}
