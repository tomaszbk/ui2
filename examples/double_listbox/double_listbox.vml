Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Double listbox",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Move values between the two collections.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                View(
                    id: available_panel,
                    x: 18,
                    y: 78,
                    width: ((card.width - 82) / 2),
                    height: card.height - 154,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Available(${app.available.len})",
                            x: 14,
                            y: 12,
                            width: available_panel.width - 28,
                            height: 22,
                            style: [foreground(#334155), font_size(13), weight(700)],
                        )
                        Scroll(
                            id: available_list,
                            x: 10,
                            y: 42,
                            width: available_panel.width - 20,
                            height: available_panel.height - 52,
                            style: [background(#FFFFFF)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                for index, item in app.available key item.id {
                                    Button(
                                        text: "${item.label}  →",
                                        on_click: app.move_right(item.id),
                                        native: true,
                                        x: 8,
                                        y: 6 + index * 40,
                                        width: available_list.width - 32,
                                        height: 34,
                                    )
                                }
                            }
                        }
                    }
                }
                View(
                    id: selected_panel,
                    x: 46 +((card.width - 82) / 2),
                    y: 78,
                    width: ((card.width - 82) / 2),
                    height: card.height - 154,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Selected(${app.selected.len})",
                            x: 14,
                            y: 12,
                            width: selected_panel.width - 28,
                            height: 22,
                            style: [foreground(#334155), font_size(13), weight(700)],
                        )
                        Scroll(
                            id: selected_list,
                            x: 10,
                            y: 42,
                            width: selected_panel.width - 20,
                            height: selected_panel.height - 52,
                            style: [background(#FFFFFF)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                for index, item in app.selected key item.id {
                                    Button(
                                        text: "←  ${item.label}",
                                        on_click: app.move_left(item.id),
                                        native: true,
                                        x: 8,
                                        y: 6 + index * 40,
                                        width: selected_list.width - 32,
                                        height: 34,
                                    )
                                }
                            }
                        }
                    }
                }
                Button(
                    id: reset_lists,
                    text: "Reset",
                    on_click: app.reset(),
                    native: true,
                    x: 18,
                    y: card.height - 62,
                    width: 100,
                    height: 34,
                )
                Button(
                    id: show_values,
                    text: "Get values",
                    on_click: app.show_values(),
                    native: true,
                    x: card.width - 138,
                    y: card.height - 62,
                    width: 120,
                    height: 34,
                )
                Label(
                    id: transfer_status,
                    text: app.status,
                    x: 132,
                    y: card.height - 55,
                    width: card.width - 284,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
