Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            x: (root.width - 308) / 2,
            y: 16,
            width: 308,
            height: 164,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Formatting", x: 16, y: 14, width: 276, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                ToggleButton(
                    id: bold,
                    text: "Bold",
                    bind.pressed: app.bold,
                    group: "formatting",
                    allow_no_selection: false,
                    x: 16,
                    y: 54,
                    width: 80,
                    height: 40,
                    down_background: #1D4ED8,
                    down_color: #FFFFFF,
                    style: [background(#E2E8F0), foreground(#1E293B), radius(7)],
                )
                ToggleButton(
                    id: italic,
                    text: "Italic",
                    bind.pressed: app.italic,
                    group: "formatting",
                    allow_no_selection: false,
                    x: 104,
                    y: 54,
                    width: 80,
                    height: 40,
                    down_background: #1D4ED8,
                    down_color: #FFFFFF,
                    style: [background(#E2E8F0), foreground(#1E293B), radius(7)],
                )
                Label(
                    id: state,
                    text: app.bold ? "Bold" : "Italic",
                    x: 200,
                    y: 54,
                    width: 92,
                    height: 40,
                    style: [foreground(#1D4ED8), text_align(center)],
                )
            }
        }
    }
}
