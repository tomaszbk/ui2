Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "People", x: 16, y: 14, width: 210, height: 28, style: [foreground(#111827), font_size(17), weight(700)])
                Label(text: "Filter prefix", x: 16, y: 48, width: 210, height: 20, style: [foreground(#475569), font_size(12)])
                TextInput(
                    id: filter,
                    bind.text: app.filter,
                    on_change: app.filter_changed(),
                    placeholder: "Surname prefix",
                    x: 16,
                    y: 70,
                    width: 210,
                    height: 32,
                    style: [background(#F8FAFC), radius(7), font_size(13)],
                )
                Scroll(
                    id: people_list,
                    x: 16,
                    y: 112,
                    width: 210,
                    height: card.height - 176,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for index, item in app.visible_people key item.id {
                            Button(
                                text: item.id == app.selected_id ? "✓ ${item.display}" : item.display,
                                on_click: app.select_person(item.id),
                                native: true,
                                x: 8,
                                y: index * 34,
                                width: 178,
                                height: 30,
                                style: [background(item.id == app.selected_id ? #DBEAFE : #FFFFFF), foreground(#111827), radius(6), font_size(13)],
                            )
                        }
                    }
                }
                Label(
                    text: "Edit person",
                    x: 246,
                    y: 14,
                    width: card.width - 262,
                    height: 28,
                    style: [foreground(#111827), font_size(17), weight(700)],
                )
                Label(text: "Name", x: 246, y: 48, width: card.width - 262, height: 20, style: [foreground(#475569), font_size(12)])
                TextInput(
                    id: name,
                    bind.text: app.name,
                    placeholder: "Name",
                    x: 246,
                    y: 70,
                    width: card.width - 262,
                    height: 32,
                    style: [background(#F8FAFC), radius(7), font_size(13)],
                )
                Label(text: "Surname", x: 246, y: 114, width: card.width - 262, height: 20, style: [foreground(#475569), font_size(12)])
                TextInput(
                    id: surname,
                    bind.text: app.surname,
                    placeholder: "Surname",
                    x: 246,
                    y: 136,
                    width: card.width - 262,
                    height: 32,
                    style: [background(#F8FAFC), radius(7), font_size(13)],
                )
                Button(
                    id: create,
                    text: "Create",
                    on_click: app.create_person(),
                    native: true,
                    x: 246,
                    y: 184,
                    width: (card.width - 278) / 3,
                    height: 34,
                    style: [background(#3478D4), foreground(#FFFFFF), radius(7)],
                )
                Button(
                    id: update,
                    text: "Update",
                    on_click: app.update_person(),
                    native: true,
                    enabled: app.selected_id >= 0,
                    x: 254 +(card.width - 278) / 3,
                    y: 184,
                    width: (card.width - 278) / 3,
                    height: 34,
                    style: [background(#E2E8F0), radius(7)],
                )
                Button(
                    id: delete,
                    text: "Delete",
                    on_click: app.delete_person(),
                    native: true,
                    enabled: app.selected_id >= 0,
                    x: 262 +(card.width - 278) / 3 * 2,
                    y: 184,
                    width: (card.width - 278) / 3,
                    height: 34,
                    style: [background(#FEE2E2), foreground(#991B1B), radius(7)],
                )
                Label(
                    id: message,
                    text: app.message,
                    x: 246,
                    y: 234,
                    width: card.width - 262,
                    height: 40,
                    style: [foreground(#166534), font_size(13), lines(2)],
                )
                Label(
                    text: "${app.visible_people.len}/${app.people.len} people",
                    x: 16,
                    y: card.height - 42,
                    width: 210,
                    height: 18,
                    style: [foreground(#64748B), font_size(13), text_align(center)],
                )
            }
        }
    }
}
