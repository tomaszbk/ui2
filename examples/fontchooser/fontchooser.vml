Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Font chooser",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Choose a family, size, color, and emphasis for the editor.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Dropdown(
                    id: "font_family",
                    bind.text: app.font_choice,
                    on_change: app.style_changed(),
                    x: 18,
                    y: 74,
                    width: 190,
                    height: 38,
                    style: [background(#F1F5F9), radius(7)],
                ) {
                    Option(text: "System")
                    Option(text: "Serif")
                    Option(text: "Monospace")
                    Option(text: "Arial")
                }
                Dropdown(
                    id: "font_size",
                    bind.text: app.size_choice,
                    on_change: app.style_changed(),
                    x: 220,
                    y: 74,
                    width: 100,
                    height: 38,
                    style: [background(#F1F5F9), radius(7)],
                ) {
                    Option(text: "18")
                    Option(text: "24")
                    Option(text: "30")
                    Option(text: "36")
                }
                Dropdown(
                    id: "text_color",
                    bind.text: app.color_choice,
                    on_change: app.style_changed(),
                    x: 332,
                    y: 74,
                    width: 150,
                    height: 38,
                    style: [background(#F1F5F9), radius(7)],
                ) {
                    Option(text: "Red")
                    Option(text: "Blue")
                    Option(text: "Green")
                    Option(text: "Purple")
                }
                Button(
                    id: "reset_style",
                    text: "Reset",
                    on_click: app.reset_style(),
                    native: true,
                    x: card.width - 118,
                    y: 76,
                    width: 100,
                    height: 34,
                )
                Checkbox(
                    id: "bold",
                    text: "Bold",
                    bind.checked: app.bold,
                    x: 18,
                    y: 122,
                    width: 100,
                    height: 30,
                    style: [foreground(#334155), font_size(12)],
                )
                Checkbox(
                    id: "italic",
                    text: "Italic",
                    bind.checked: app.italic,
                    x: 126,
                    y: 122,
                    width: 100,
                    height: 30,
                    style: [foreground(#334155), font_size(12)],
                )
                TextArea(
                    id: "preview_editor",
                    bind.text: app.text,
                    x: 18,
                    y: 162,
                    width: card.width - 36,
                    height: card.height - 220,
                    style: [background(#FEF3C7), foreground(app.text_color), font_size(app.font_size), font_family(app.font_family), weight(app.bold ? 700 : 400), italic(app.italic), radius(8)],
                )
                Label(
                    id: "font_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
