Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Event inspector", x: 18, y: 14, width: 180, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: "sample_button",
                    text: "Native event",
                    on_click: callback_sample_button,
                    native: true,
                    x: card.width - 246,
                    y: 14,
                    width: 120,
                    height: 34,
                )
                Button(
                    id: "clear_events",
                    text: "Clear",
                    on_click: callback_clear,
                    native: true,
                    x: card.width - 114,
                    y: 14,
                    width: 96,
                    height: 34,
                )
                View(
                    id: "event_surface",
                    on_pointer_down: callback_event_surface,
                    on_pointer_drag: callback_event_surface,
                    on_pointer_up: callback_event_surface,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 18,
                    y: 62,
                    width: card.width - 36,
                    height: 120,
                    style: [background(#DBEAFE), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Click or drag here",
                            x: 16,
                            y: 28,
                            width: event_surface.width - 32,
                            height: 28,
                            style: [text_align(center), foreground(#1D4ED8), font_size(17), weight(700)],
                        )
                        Label(
                            text: "Keyboard events are captured when an editor is not focused.",
                            x: 16,
                            y: 62,
                            width: event_surface.width - 32,
                            height: 20,
                            style: [text_align(center), foreground(#3B82F6), font_size(11)],
                        )
                    }
                }
                View(
                    x: 18,
                    y: 194,
                    width: (card.width - 44) / 2,
                    height: 52,
                    style: [background(#F8FAFC), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Pointer events",
                            x: 10,
                            y: 7,
                            width: (card.width - 84) / 2,
                            height: 16,
                            style: [text_align(center), foreground(#64748B), font_size(10)],
                        )
                        Label(
                            text: "${app.pointer_events}",
                            x: 10,
                            y: 23,
                            width: (card.width - 84) / 2,
                            height: 22,
                            style: [text_align(center), foreground(#111827), font_size(16), weight(700)],
                        )
                    }
                }
                View(
                    x: 26 +(card.width - 44) / 2,
                    y: 194,
                    width: (card.width - 44) / 2,
                    height: 52,
                    style: [background(#F8FAFC), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Key events",
                            x: 10,
                            y: 7,
                            width: (card.width - 84) / 2,
                            height: 16,
                            style: [text_align(center), foreground(#64748B), font_size(10)],
                        )
                        Label(
                            text: "${app.key_events}",
                            x: 10,
                            y: 23,
                            width: (card.width - 84) / 2,
                            height: 22,
                            style: [text_align(center), foreground(#111827), font_size(16), weight(700)],
                        )
                    }
                }
                Label(
                    id: "last_event",
                    text: app.last_event,
                    x: 18,
                    y: 258,
                    width: card.width - 36,
                    height: 24,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
                TextArea(
                    id: "event_history",
                    text: app.history,
                    readonly: true,
                    x: 18,
                    y: 290,
                    width: card.width - 36,
                    height: card.height - 308,
                    style: [background(#FFFBEB), foreground(#78350F), font_family("Courier New"), font_size(11), radius(7)],
                )
            }
        }
    }
}
