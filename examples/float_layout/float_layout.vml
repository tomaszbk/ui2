Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Independent positioning",
            x: 20,
            y: 16,
            width: root.width - 40,
            height: 30,
            style: [foreground(#0F172A), font_size(20), weight(700)],
        )
        Absolute(
            id: canvas,
            x: 20,
            y: 60,
            width: root.width - 40,
            height: 170,
            style: [background(#FFFFFF), radius(10)],
        ) {
            View(
                width: canvas.width * 0.72,
                height: canvas.height * 0.55,
                x: canvas.width * 0.14,
                y: canvas.height * 0.225,
                style: [background(#DBEAFE), radius(12)],
            )
            Button(
                id: center_action,
                text: "Centered",
                width: 120,
                height: 42,
                x: (canvas.width - 120) / 2,
                y: (canvas.height - 42) / 2,
                style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
            )
            Label(
                text: "bottom right",
                width: 96,
                height: 24,
                x: canvas.width * 0.96 - 96,
                y: canvas.height * 0.94 - 24,
                style: [foreground(#475569), font_size(12), text_align(right)],
            )
        }
    }
}
