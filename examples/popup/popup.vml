Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Profile: ${app.name}",
            x: 20,
            y: 52,
            width: root.width - 40,
            height: 34,
            style: [text_align(center), foreground(#0F172A), font_size(22), weight(700)],
        )
        Button(
            text: "Edit profile",
            on_click: app.open_editor(),
            x: (root.width - 140) / 2,
            y: 116,
            width: 140,
            height: 40,
            style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
        )
        Popup(
            id: "editor",
            width: root.width,
            height: root.height,
            open: app.editing,
            title: "Edit profile",
            on_dismiss: app.close_editor(),
            content_width: 340,
            content_height: 220,
            title_height: 52,
            separator_height: 1,
            overlay_background: #475569,
            style: [background(#FFFFFF), radius(12)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Display name", x: 24, y: 20, width: 292, height: 22, style: [foreground(#475569)])
                TextInput(
                    bind.text: app.name,
                    x: 24,
                    y: 48,
                    width: 292,
                    height: 38,
                    style: [background(#F8FAFC), radius(7)],
                )
                Button(
                    text: "Cancel",
                    on_click: app.close_editor(),
                    x: 46,
                    y: 112,
                    width: 110,
                    height: 38,
                    style: [background(#E2E8F0), foreground(#334155), radius(8)],
                )
                Button(
                    text: "Save",
                    on_click: app.save_editor(),
                    x: 184,
                    y: 112,
                    width: 110,
                    height: 38,
                    style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
                )
            }
        }
    }
}
