Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Accordion",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Open one component page at a time.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Scroll(
                    id: "section_list",
                    x: 18,
                    y: 74,
                    width: card.width - 36,
                    height: card.height - 126,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.sections,
                            key: item.id,
                        ) {
                            View(
                                x: 8,
                                y: 8 + index * 48 +(app.open_id > 0 && item.id > app.open_id ? 120 : 0),
                                width: section_list.width - 32,
                                height: item.id == app.open_id ? 160 : 40,
                                style: [background(#FFFFFF), radius(7)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Button(
                                        text: item.id == app.open_id ? "▾  ${item.title}" : "▸  ${item.title}",
                                        on_click: app.toggle_section(item.id),
                                        native: true,
                                        x: 4,
                                        y: 3,
                                        width: section_list.width - 40,
                                        height: 34,
                                    )
                                    View(
                                        hidden: item.id != app.open_id,
                                        x: 8,
                                        y: 44,
                                        width: section_list.width - 48,
                                        height: 108,
                                        style: [background(item.color), radius(7)],
                                    ) {
                                        Absolute(
                                            style: [transparent(true)],
                                        ) {
                                            Label(
                                                text: item.description,
                                                x: 14,
                                                y: 16,
                                                width: section_list.width - 76,
                                                height: 24,
                                                style: [foreground(#1E293B), font_size(14), weight(700)],
                                            )
                                            Label(
                                                text: item.detail,
                                                x: 14,
                                                y: 49,
                                                width: section_list.width - 76,
                                                height: 40,
                                                style: [foreground(#475569), font_size(12), lines(2)],
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Label(
                    id: "accordion_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
