Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(text: "Screen manager", x: 20, y: 14, width: root.width - 40, height: 30, style: [foreground(#0F172A), font_size(20), weight(700)])
        ScreenManager(
            id: navigation,
            x: 20,
            y: 56,
            width: root.width - 40,
            height: 240,
            current: app.current,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Screen(
                id: home,
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(text: "Home", x: 24, y: 26, width: 240, height: 34, style: [foreground(#0F172A), font_size(24), weight(700)])
                    Label(text: "Only this screen is mounted.", x: 24, y: 68, width: 300, height: 24, style: [foreground(#64748B)])
                    Button(
                        text: "Open details",
                        on_click: app.show_details(),
                        x: 24,
                        y: 116,
                        width: 140,
                        height: 38,
                        style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
                    )
                }
            }
            Screen(
                id: details,
                style: [background(#EFF6FF)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(text: "Details", x: 24, y: 26, width: 240, height: 34, style: [foreground(#1E3A8A), font_size(24), weight(700)])
                    Label(
                        text: "State-driven navigation keeps content isolated.",
                        x: 24,
                        y: 68,
                        width: 340,
                        height: 24,
                        style: [foreground(#475569)],
                    )
                    Button(
                        text: "Back home",
                        on_click: app.show_home(),
                        x: 24,
                        y: 116,
                        width: 120,
                        height: 38,
                        style: [background(#FFFFFF), foreground(#1D4ED8), radius(8)],
                    )
                }
            }
        }
    }
}
