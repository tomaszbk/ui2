Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    id: "centered_label",
                    text: "Centered text",
                    x: 24,
                    y: 24,
                    width: card.width - 48,
                    height: card.height - 48,
                    style: [foreground(#1E293B), font_size(20), weight(700), text_align(center)],
                )
            }
        }
    }
}
