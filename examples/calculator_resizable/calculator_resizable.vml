Screen(
    id: "root",
    background: #1F2937,
) {
    Absolute(
        transparent: true,
    ) {
        View(
            id: "display_panel",
            x: (root.width * 0.04),
            y: (root.width * 0.04),
            width: root.width -(root.width * 0.04) * 2,
            height: (root.height * 0.16),
            background: #F8FAFC,
            corner_radius: (((root.height -((root.width * 0.04) +(root.height * 0.16) +(root.height * 0.02)) -(root.width * 0.04) -(root.height * 0.02) * 4) / 5) * 0.25),
        ) {
            Absolute(
                transparent: true,
            ) {
                Label(
                    id: "display",
                    text: app.display,
                    x: (root.width * 0.04),
                    y: 0,
                    width: root.width -(root.width * 0.04) * 4,
                    height: (root.height * 0.16),
                    color: #111827,
                    font_size: (root.height / 10),
                    align: right,
                )
            }
        }
        Repeater(
            model: app.keys,
            key: item.key,
        ) {
            Button(
                text: item.text,
                on_tap: app.press(item.text),
                x: (root.width * 0.04) + item.column *(((root.width -(root.width * 0.04) * 2 -(root.height * 0.02) * 3) / 4) +(root.height * 0.02)),
                y: ((root.width * 0.04) +(root.height * 0.16) +(root.height * 0.02)) + item.row *(((root.height -((root.width * 0.04) +(root.height * 0.16) +(root.height * 0.02)) -(root.width * 0.04) -(root.height * 0.02) * 4) / 5) +(root.height * 0.02)),
                width: ((root.width -(root.width * 0.04) * 2 -(root.height * 0.02) * 3) / 4),
                height: ((root.height -((root.width * 0.04) +(root.height * 0.16) +(root.height * 0.02)) -(root.width * 0.04) -(root.height * 0.02) * 4) / 5),
                background: item.role == "clear" ? #EF4444 : item.role == "operator" ? #3478D4 : item.role == "utility" ? #64748B : #E2E8F0,
                color: item.role == "digit" ? #111827 : #FFFFFF,
                font_size: (root.height / 20),
                bold: item.text == "=",
                align: center,
                corner_radius: (((root.height -((root.width * 0.04) +(root.height * 0.16) +(root.height * 0.02)) -(root.width * 0.04) -(root.height * 0.02) * 4) / 5) * 0.25),
            )
        }
    }
}
