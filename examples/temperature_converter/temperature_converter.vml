Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Flex(
        justify: center,
        align_items: start,
        style: [padding(16), transparent(true)],
    ) {
        Column(
            id: card,
            width: 568,
            max_width: 568,
            height: 136,
            gap: 10,
            style: [padding(16), background(#FFFFFF), radius(10)],
        ) {
            Label(text: "Temperature Converter", height: 26, style: [foreground(#111827), font_size(18), weight(700)])
            Row(
                gap: 16,
                style: [transparent(true)],
            ) {
                Column(
                    flex_basis: 0,
                    flex_grow: 1,
                    gap: 4,
                    style: [transparent(true)],
                ) {
                    Label(text: "Celsius", height: 18, style: [foreground(#475569), font_size(12)])
                    TextInput(
                        id: celsius,
                        bind.text: app.celsius,
                        on_change: app.update_from_celsius(),
                        placeholder: "0",
                        keyboard: decimal,
                        height: 42,
                        style: [background(app.celsius_valid ? #F8FAFC : #FED7AA), foreground(#111827), radius(7)],
                    )
                }
                Column(
                    flex_basis: 0,
                    flex_grow: 1,
                    gap: 4,
                    style: [transparent(true)],
                ) {
                    Label(text: "Fahrenheit", height: 18, style: [foreground(#475569), font_size(12)])
                    TextInput(
                        id: fahrenheit,
                        bind.text: app.fahrenheit,
                        on_change: app.update_from_fahrenheit(),
                        placeholder: "32",
                        keyboard: decimal,
                        height: 42,
                        style: [background(app.fahrenheit_valid ? #F8FAFC : #FED7AA), foreground(#111827), radius(7)],
                    )
                }
            }
        }
    }
}
