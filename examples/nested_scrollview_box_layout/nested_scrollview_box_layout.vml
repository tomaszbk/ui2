Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Nested scrollviews in a box layout",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "The outer canvas and every text box scroll independently.",
                    x: 16,
                    y: 42,
                    width: card.width - 32,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Scroll(
                    id: "box_grid",
                    x: 16,
                    y: 74,
                    width: card.width - 32,
                    height: card.height - 90,
                    style: [background(#FEF9C3)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.boxes,
                            key: item.id,
                        ) {
                            TextArea(
                                text: item.content,
                                x: 8 + item.column *((box_grid.width - 16) / 5),
                                y: 8 + item.row * 112,
                                width: (box_grid.width - 16) / 5 - 8,
                                height: 104,
                                style: [background(#FFFFFF), foreground(#475569), font_size(11), radius(6)],
                            )
                        }
                    }
                }
            }
        }
    }
}
