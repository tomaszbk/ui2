Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: ((root.width -(root.width - 32 < 648 ? root.width - 32 : 648)) / 2),
            y: 16,
            width: (root.width - 32 < 648 ? root.width - 32 : 648),
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Country",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Exclusive choices using ui2's portable selection controls.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Checkbox(
                    id: compact_switch,
                    text: "Compact horizontal layout",
                    bind.checked: app.compact,
                    x: 18,
                    y: 72,
                    width: card.width - 36,
                    height: 30,
                    style: [foreground(#334155), font_size(13)],
                )
                View(
                    id: choices,
                    x: 18,
                    y: 112,
                    width: card.width - 36,
                    height: app.compact ? 66 : 158,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for index, item in app.countries key item.id {
                            Checkbox(
                                text: item.name,
                                checked: item.name == app.selected_country,
                                on_click: app.select_country(item.name),
                                x: app.compact ? 12 + index *((choices.width - 24) / 4) : 16,
                                y: app.compact ? 18 : 10 + index * 36,
                                width: app.compact ?(choices.width - 24) / 4 : choices.width - 32,
                                height: 30,
                                style: [foreground(#1E293B), font_size(12)],
                            )
                        }
                    }
                }
                View(
                    x: 18,
                    y: app.compact ? 192 : 284,
                    width: card.width - 36,
                    height: 42,
                    style: [background(#DCFCE7), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            id: selected_country,
                            text: app.message,
                            x: 10,
                            y: 11,
                            width: card.width - 56,
                            height: 20,
                            style: [text_align(center), foreground(#166534), font_size(13)],
                        )
                    }
                }
            }
        }
    }
}
