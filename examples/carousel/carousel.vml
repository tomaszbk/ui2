Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(text: "Carousel", x: 20, y: 14, width: 180, height: 30, style: [foreground(#0F172A), font_size(20), weight(700)])
        Label(text: "${app.index + 1} / 3", x: root.width - 120, y: 18, width: 100, height: 22, style: [text_align(right), foreground(#64748B)])
        Carousel(
            id: "gallery",
            x: 20,
            y: 56,
            width: root.width - 40,
            height: 220,
            index: app.index,
            direction: right,
            loop: true,
            style: [background(#FFFFFF), radius(10)],
        ) {
            CarouselSlide(
                id: "ocean",
                style: [background(#DBEAFE)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Ocean",
                        x: 24,
                        y: 56,
                        width: ocean.width - 48,
                        height: 44,
                        style: [text_align(center), foreground(#1E3A8A), font_size(30), weight(700)],
                    )
                }
            }
            CarouselSlide(
                id: "forest",
                style: [background(#DCFCE7)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Forest",
                        x: 24,
                        y: 56,
                        width: forest.width - 48,
                        height: 44,
                        style: [text_align(center), foreground(#14532D), font_size(30), weight(700)],
                    )
                }
            }
            CarouselSlide(
                id: "sunset",
                style: [background(#FFEDD5)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(
                        text: "Sunset",
                        x: 24,
                        y: 56,
                        width: sunset.width - 48,
                        height: 44,
                        style: [text_align(center), foreground(#7C2D12), font_size(30), weight(700)],
                    )
                }
            }
        }
        Button(
            text: "Previous",
            on_click: app.previous(),
            x: 20,
            y: 290,
            width: 110,
            height: 36,
            style: [background(#FFFFFF), foreground(#1D4ED8), radius(8)],
        )
        Button(
            text: "Next",
            on_click: app.next(),
            x: root.width - 130,
            y: 290,
            width: 110,
            height: 36,
            style: [background(#2563EB), foreground(#FFFFFF), radius(8)],
        )
    }
}
