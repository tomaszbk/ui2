Screen(
    id: "root",
    style: [background(app.screen_background), transparent(app.transparent_screen)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(id: "card_shadow", x: 16, y: 14, width: root.width - 32, height: 122, style: [background(#020617), radius(22)])
        View(
            id: "card",
            x: 12,
            y: 10,
            width: root.width - 32,
            height: 122,
            style: [background(#111827), radius(22), border_color(#334155), border_width(1)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                View(
                    id: "window_drag",
                    on_pointer_down: callback_window_drag,
                    clickable: true,
                    draggable: true,
                    x: 0,
                    y: 0,
                    width: card.width,
                    height: 48,
                    style: [transparent(true)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(x: 18, y: 18, width: 10, height: 10, style: [background(#34D399), radius(5)])
                        Label(
                            text: "FOCUS WIDGET",
                            x: 38,
                            y: 13,
                            width: 200,
                            height: 22,
                            style: [foreground(#E2E8F0), font_size(12), weight(700)],
                        )
                        Label(
                            text: "drag anywhere on this header",
                            x: 202,
                            y: 14,
                            width: card.width - 252,
                            height: 20,
                            style: [text_align(right), foreground(#64748B), font_size(10)],
                        )
                    }
                }
                Button(
                    id: "close",
                    text: "×",
                    on_click: callback_close,
                    x: card.width - 42,
                    y: 10,
                    width: 30,
                    height: 30,
                    accessibility_label: "Close widget",
                    style: [background(#7F1D1D), radius(15), foreground(#FEE2E2), font_size(18), weight(700)],
                )
                Label(
                    text: app.completed_label,
                    x: 20,
                    y: 57,
                    width: card.width - 40,
                    height: 26,
                    style: [foreground(#F8FAFC), font_size(19), weight(700)],
                )
                Label(text: app.platform_note, x: 20, y: 91, width: card.width - 40, height: 18, style: [foreground(#94A3B8), font_size(10)])
            }
        }
        View(id: "action_shadow", x: root.width / 2 - 130, y: 152, width: 260, height: 48, style: [background(#020617), radius(24)])
        View(
            id: "actions",
            x: root.width / 2 - 132,
            y: 148,
            width: 260,
            height: 48,
            style: [background(#1E293B), radius(24), border_color(#475569), border_width(1)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Button(
                    id: "decrement",
                    text: "−",
                    on_click: callback_decrement,
                    enabled: app.completed > 0,
                    x: 8,
                    y: 7,
                    width: 50,
                    height: 34,
                    accessibility_label: "Remove a completed session",
                    style: [background(#334155), radius(17), foreground(#F8FAFC), font_size(18), weight(700)],
                )
                Button(
                    id: "reset",
                    text: app.completed,
                    x: 68,
                    y: 7,
                    width: 120,
                    height: 34,
                    accessibility_label: "Reset completed sessions",
                    on_click: callback_reset,
                    style: [background(#0F172A), radius(17), foreground(#A7F3D0), font_size(16), weight(700)],
                )
                Button(
                    id: "increment",
                    text: "+",
                    on_click: callback_increment,
                    x: 198,
                    y: 7,
                    width: 54,
                    height: 34,
                    accessibility_label: "Complete a focus session",
                    style: [background(#047857), radius(17), foreground(#ECFDF5), font_size(18), weight(700)],
                )
            }
        }
    }
}
