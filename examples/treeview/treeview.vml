Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Tree view",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Expand nested folders and select leaf files.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Scroll(
                    id: "tree_list",
                    x: 18,
                    y: 76,
                    width: card.width - 36,
                    height: card.height - 130,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.visible,
                            key: item.id,
                        ) {
                            Button(
                                text: item.folder ?(item.expanded ? "▾  ${item.title}" : "▸  ${item.title}") : "•  ${item.title}",
                                on_click: app.select_node(item.id),
                                native: true,
                                x: 8 + item.depth * 24,
                                y: 6 + index * 38,
                                width: tree_list.width - 32 - item.depth * 24,
                                height: 32,
                            )
                        }
                    }
                }
                Label(
                    id: "tree_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
