Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Color box", x: 18, y: 14, width: 220, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: "store",
                    text: "Store in slot",
                    on_click: callback_store,
                    native: true,
                    x: card.width - 148,
                    y: 13,
                    width: 130,
                    height: 34,
                )
                View(
                    id: "hue_strip",
                    on_pointer_down: callback_hue_strip,
                    on_pointer_drag: callback_hue_strip,
                    on_pointer_up: callback_hue_strip,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 18,
                    y: 60,
                    width: 32,
                    height: 256,
                    style: [background(#FFFFFF)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.hue_cells,
                            key: item.key,
                        ) {
                            View(x: 0, y: item.index * 8, width: 32, height: 8, style: [background(item.color)])
                        }
                        View(x: 0, y: app.hue_marker - 2, width: 32, height: 4, style: [background(#FFFFFF)])
                    }
                }
                View(
                    id: "sv_square",
                    on_pointer_down: callback_sv_square,
                    on_pointer_drag: callback_sv_square,
                    on_pointer_up: callback_sv_square,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 62,
                    y: 60,
                    width: 256,
                    height: 256,
                    style: [background(app.hue_color)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.sv_cells,
                            key: item.key,
                        ) {
                            View(x: item.column * 16, y: item.row * 16, width: 16, height: 16, style: [background(item.color)])
                        }
                        View(
                            x: app.sv_marker_x - 7,
                            y: app.sv_marker_y - 7,
                            width: 14,
                            height: 14,
                            style: [background(#FFFFFF), radius(7)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                View(x: 3, y: 3, width: 8, height: 8, style: [background(app.color), radius(4)])
                            }
                        }
                    }
                }
                View(
                    id: "swatch_grid",
                    on_pointer_up: callback_swatch_grid,
                    clickable: true,
                    cursor: "pointing_hand",
                    x: 332,
                    y: 60,
                    width: 154,
                    height: 123,
                    style: [background(#FFFFFF)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.swatches,
                            key: item.key,
                        ) {
                            View(
                                x: item.column * 80,
                                y: item.row * 43,
                                width: 74,
                                height: 37,
                                style: [background(item.selected ? #0F172A : #E2E8F0), radius(7)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    View(x: 3, y: 3, width: 68, height: 31, style: [background(item.color), radius(5)])
                                }
                            }
                        }
                    }
                }
                Label(text: "Click a slot to recall it.", x: 332, y: 192, width: 200, height: 18, style: [foreground(#64748B), font_size(11)])
                Label(text: "R", x: 500, y: 64, width: 20, height: 20, style: [foreground(#334155), font_size(13), weight(700)])
                TextInput(
                    id: "red_input",
                    text: app.red_text,
                    on_change: callback_red_input,
                    on_submit: callback_red_input,
                    x: 524,
                    y: 58,
                    width: 84,
                    height: 32,
                    keyboard: decimal,
                    style: [background(app.valid ? #FFFFFF : #FEE2E2), radius(7), text_align(center)],
                )
                Label(text: "G", x: 500, y: 104, width: 20, height: 20, style: [foreground(#334155), font_size(13), weight(700)])
                TextInput(
                    id: "green_input",
                    text: app.green_text,
                    on_change: callback_green_input,
                    on_submit: callback_green_input,
                    x: 524,
                    y: 98,
                    width: 84,
                    height: 32,
                    keyboard: decimal,
                    style: [background(app.valid ? #FFFFFF : #FEE2E2), radius(7), text_align(center)],
                )
                Label(text: "B", x: 500, y: 144, width: 20, height: 20, style: [foreground(#334155), font_size(13), weight(700)])
                TextInput(
                    id: "blue_input",
                    text: app.blue_text,
                    on_change: callback_blue_input,
                    on_submit: callback_blue_input,
                    x: 524,
                    y: 138,
                    width: 84,
                    height: 32,
                    keyboard: decimal,
                    style: [background(app.valid ? #FFFFFF : #FEE2E2), radius(7), text_align(center)],
                )
                View(
                    id: "current_color",
                    x: 500,
                    y: 186,
                    width: card.width - 518,
                    height: 130,
                    style: [background(app.color), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: app.display_color(),
                            x: 0,
                            y: 104,
                            width: card.width - 518,
                            height: 18,
                            style: [text_align(center), foreground(#FFFFFF), font_size(11)],
                        )
                    }
                }
                View(
                    id: "preview",
                    x: 18,
                    y: 332,
                    width: card.width - 36,
                    height: 96,
                    style: [background(#F8FAFC), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Here a simple ui rectangle",
                            x: 20,
                            y: 28,
                            width: card.width - 76,
                            height: 44,
                            style: [foreground(app.color), font_size(30)],
                        )
                    }
                }
                Label(
                    text: "The picked color drives the rectangle's text, exactly as the original colorbox connects its component to a rectangle style.",
                    x: 18,
                    y: 440,
                    width: card.width - 36,
                    height: 18,
                    style: [foreground(#64748B), font_size(11)],
                )
                Label(
                    id: "colorbox_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(app.valid ? #166534 : #991B1B), font_size(12)],
                )
            }
        }
    }
}
