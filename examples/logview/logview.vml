Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Log view",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    id: status,
                    text: app.status,
                    x: 16,
                    y: 42,
                    width: card.width - 32,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                TextArea(
                    id: log,
                    text: app.log,
                    readonly: true,
                    x: 16,
                    y: 72,
                    width: card.width - 32,
                    height: card.height - 134,
                    style: [background(#FCF4E4), foreground(#334155), font_size(13), radius(7)],
                )
                Button(
                    id: start_scan,
                    text: "Start scan",
                    on_click: app.start_scan(),
                    native: true,
                    x: 16,
                    y: card.height - 50,
                    width: 130,
                    height: 34,
                )
                Button(
                    id: clear,
                    text: "Clear",
                    on_click: app.clear(),
                    native: true,
                    enabled: app.log.len > 0,
                    x: card.width - 106,
                    y: card.height - 50,
                    width: 90,
                    height: 34,
                )
            }
        }
    }
}
