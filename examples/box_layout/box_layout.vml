Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(
            text: "Responsive box layout",
            x: 20,
            y: 14,
            width: root.width - 40,
            height: 28,
            style: [foreground(#111827), font_size(18), weight(700)],
        )
        View(
            id: canvas,
            x: 16,
            y: 54,
            width: root.width - 32,
            height: root.height - 70,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                View(
                    id: red,
                    x: 16,
                    y: 16,
                    width: 72,
                    height: 72,
                    style: [background(#FF6464), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "fixed",
                            x: 0,
                            y: 0,
                            width: red.width,
                            height: red.height,
                            style: [text_align(center), foreground(#5F1111), font_size(12)],
                        )
                    }
                }
                View(
                    id: green,
                    x: 104,
                    y: 48,
                    width: canvas.width - 136,
                    height: canvas.height - 80,
                    style: [background(#D9F99D), radius(10)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "stretches with the window",
                            x: 12,
                            y: 12,
                            width: green.width - 24,
                            height: 22,
                            style: [foreground(#365314), font_size(13)],
                        )
                    }
                }
                View(
                    id: blue,
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    width: canvas.width / 2 - 16,
                    height: canvas.height / 2 - 16,
                    style: [background(#BFDBFE), radius(10)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            id: blue_caption,
                            text: "50% anchored",
                            x: 12,
                            y: blue.height - 32,
                            width: blue.width - 80,
                            height: 20,
                            style: [text_align(right), foreground(#1E3A8A), font_size(12)],
                        )
                    }
                }
                View(
                    id: white_anchor,
                    x: canvas.width - 72,
                    y: canvas.height - 72,
                    width: 56,
                    height: 56,
                    style: [background(#FFFFFF), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(id: black_anchor, x: 8, y: 8, width: 40, height: 40, style: [background(#111827), radius(6)])
                    }
                }
            }
        }
    }
}
