Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Transitions", x: 18, y: 14, width: 180, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    text: app.target_label,
                    x: card.width - 286,
                    y: 18,
                    width: 150,
                    height: 20,
                    style: [text_align(right), foreground(#64748B), font_size(11)],
                )
                Button(
                    id: slide,
                    text: app.moving ? "Redirect" : "Slide",
                    on_click: callback_slide,
                    native: true,
                    x: card.width - 126,
                    y: 13,
                    width: 108,
                    height: 34,
                )
                View(
                    id: stage,
                    x: 18,
                    y: 62,
                    width: card.width - 36,
                    height: card.height - 146,
                    style: [background(#F8FAFC), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 24,
                            y: 24,
                            width: stage.width - 48,
                            height: stage.height - 48,
                            style: [background(#FFFFFF), radius(8)],
                        )
                        View(
                            id: moving_tile,
                            x: app.target_x,
                            y: app.target_y,
                            motion: app.tile_motion(),
                            width: 82,
                            height: 82,
                            style: [background(#4F6FA8), radius(14)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "V",
                                    x: 0,
                                    y: 0,
                                    width: 82,
                                    height: 82,
                                    style: [text_align(center), foreground(#FFFFFF), font_size(34), weight(700)],
                                )
                            }
                        }
                    }
                }
                View(
                    x: 18,
                    y: card.height - 66,
                    width: card.width - 36,
                    height: 6,
                    style: [background(#E2E8F0), radius(3)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(x: 0, y: 0, width: app.progress *(card.width - 36), height: 6, style: [background(#60A5FA), radius(3)])
                    }
                }
                Label(
                    id: transition_status,
                    text: app.status,
                    x: 18,
                    y: card.height - 48,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(11)],
                )
            }
        }
    }
}
