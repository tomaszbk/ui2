Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(text: "Dashboard", x: 20, y: 16, width: root.width - 40, height: 32, style: [foreground(#0F172A), font_size(22), weight(700)])
        Grid(
            id: "dashboard",
            x: 20,
            y: 60,
            width: root.width - 40,
            height: root.height - 80,
            columns: 3,
            spacing: 8,
            style: [padding(8)],
        ) {
            Button(text: "Overview", style: [background(#DBEAFE), radius(8)])
            Button(text: "Activity", style: [background(#DCFCE7), radius(8)])
            Button(text: "Messages", style: [background(#FCE7F3), radius(8)])
            Button(text: "Files", style: [background(#FEF3C7), radius(8)])
            Button(text: "Calendar", style: [background(#EDE9FE), radius(8)])
            Button(text: "Settings", style: [background(#E2E8F0), radius(8)])
        }
    }
}
