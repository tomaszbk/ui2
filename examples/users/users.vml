Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Stack(
        align_x: stretch,
        align_y: stretch,
        style: [transparent(true)],
    ) {
        Scroll(
            id: "users_page",
            style: [background(#F1F5F9)],
        ) {
            Row(
                height: 420,
                gap: 18,
                style: [padding(16), transparent(true)],
            ) {
                Column(
                    width: 210,
                    flex_shrink: 0,
                    gap: 6,
                    style: [transparent(true)],
                ) {
                    Label(text: "Add user", height: 26, style: [font_size(18), weight(700)])
                    TextInput(
                        id: "first_name",
                        bind.text: app.first_name,
                        on_change: app.clear_error(),
                        placeholder: "First name",
                        height: 32,
                        style: [background(app.is_error ? #FFEEEE : #FFFFFF), radius(6)],
                    )
                    TextInput(
                        id: "last_name",
                        bind.text: app.last_name,
                        on_change: app.clear_error(),
                        placeholder: "Last name",
                        height: 32,
                        style: [background(app.is_error ? #FFEEEE : #FFFFFF), radius(6)],
                    )
                    TextInput(
                        id: "age",
                        bind.text: app.age,
                        on_change: app.clear_error(),
                        placeholder: "Age",
                        keyboard: decimal,
                        height: 32,
                        style: [background(app.is_error ? #FFEEEE : #FFFFFF), radius(6)],
                    )
                    TextInput(
                        id: "password",
                        bind.text: app.password,
                        placeholder: "Password",
                        secure: true,
                        height: 32,
                        style: [background(#FFFFFF), radius(6)],
                    )
                    Checkbox(
                        id: "online_registration",
                        text: "Online registration",
                        bind.checked: app.online_registration,
                        height: 30,
                        style: [font_size(12)],
                    )
                    Checkbox(
                        id: "subscribe",
                        text: "Subscribe to the newsletter",
                        bind.checked: app.subscribe,
                        height: 30,
                        style: [font_size(12)],
                    )
                    Label(text: "Country", height: 18, style: [foreground(#475569), font_size(12)])
                    Dropdown(
                        id: "country",
                        bind.text: app.country,
                        height: 32,
                        style: [background(#FFFFFF), font_size(12), radius(6)],
                    ) {
                        Option(text: "United States")
                        Option(text: "Canada")
                        Option(text: "United Kingdom")
                        Option(text: "Australia")
                    }
                    Row(
                        height: 32,
                        gap: 22,
                        style: [transparent(true)],
                    ) {
                        Button(
                            id: "add-user",
                            text: "Add user",
                            enabled: app.users.len < app.max_users,
                            on_click: app.add_user(),
                            native: true,
                            flex_grow: 1,
                            style: [background(#3478D4), foreground(#FFFFFF), radius(6), weight(700), text_align(center)],
                        )
                        Button(
                            id: "help",
                            text: "?",
                            on_click: app.open_help(),
                            native: true,
                            tooltip: "About this example",
                            width: 48,
                            style: [background(#E2E8F0), radius(16), weight(700), text_align(center)],
                        )
                    }
                    Row(
                        height: 22,
                        gap: 6,
                        align_items: center,
                        style: [transparent(true)],
                    ) {
                        ProgressBar(
                            width: 170,
                            height: 16,
                            value: app.users.len,
                            max: app.max_users,
                            style: [background(#D8DEE8), foreground(#3478D4), radius(8)],
                        )
                        Label(text: "${app.users.len}/${app.max_users}", flex_grow: 1, style: [font_size(13)])
                    }
                }
                Column(
                    flex_grow: 1,
                    gap: 8,
                    style: [transparent(true)],
                ) {
                    Scroll(
                        id: "users_table",
                        height: 270,
                        persistent: true,
                        style: [background(#FFFFFF)],
                    ) {
                        Column(
                            height: 32 + app.users.len * 34,
                            gap: 2,
                            style: [transparent(true)],
                        ) {
                            Row(
                                height: 32,
                                flex_shrink: 0,
                                gap: 14,
                                style: [padding_left(7), padding_right(7), background(#334155)],
                            ) {
                                Label(text: "First name", flex_basis: 0, flex_grow: 23, style: [foreground(#FFFFFF), font_size(13), weight(700)])
                                Label(text: "Last name", flex_basis: 0, flex_grow: 23, style: [foreground(#FFFFFF), font_size(13), weight(700)])
                                Label(text: "Age", flex_basis: 0, flex_grow: 12, style: [foreground(#FFFFFF), font_size(13), weight(700)])
                                Label(text: "Country", flex_basis: 0, flex_grow: 42, style: [foreground(#FFFFFF), font_size(13), weight(700)])
                            }
                            Repeater(
                                model: app.users,
                                key: item.id,
                            ) {
                                Row(
                                    height: 32,
                                    flex_shrink: 0,
                                    gap: 14,
                                    style: [padding_left(7), padding_right(7), background(index % 2 == 0 ? #FFFFFF : #F1F5F9)],
                                ) {
                                    Label(text: item.first_name, flex_basis: 0, flex_grow: 23, style: [foreground(#1F2937), font_size(13)])
                                    Label(text: item.last_name, flex_basis: 0, flex_grow: 23, style: [foreground(#1F2937), font_size(13)])
                                    Label(text: "${item.age}", flex_basis: 0, flex_grow: 12, style: [foreground(#1F2937), font_size(13)])
                                    Label(text: item.country, flex_basis: 0, flex_grow: 42, style: [foreground(#1F2937), font_size(13)])
                                }
                            }
                        }
                    }
                    Label(
                        hidden: ! app.is_error,
                        text: "First name, last name and age are required.",
                        height: 24,
                        style: [foreground(#B42318), font_size(13)],
                    )
                    View(flex_grow: 1, style: [transparent(true)])
                    Row(
                        height: 50,
                        justify: end,
                        style: [transparent(true)],
                    ) {
                        Image(id: "v_logo", source: app.logo_path, width: 50, height: 50)
                    }
                }
            }
        }
        Column(
            id: "help_dialog",
            hidden: ! app.show_help,
            align_self_x: center,
            align_self_y: center,
            width: 320,
            height: 145,
            gap: 8,
            style: [padding(16), background(#FFFFFF), radius(10)],
        ) {
            Label(text: "V UI Demo", height: 28, style: [font_size(19), weight(700), text_align(center)])
            Label(text: "Built with V, ui2 VML, and native controls.", height: 24, style: [font_size(14), text_align(center)])
            Row(
                justify: center,
                style: [transparent(true)],
            ) {
                Button(
                    id: "close-help",
                    text: "Close",
                    on_click: app.close_help(),
                    native: true,
                    width: 120,
                    height: 34,
                    style: [background(#3478D4), foreground(#FFFFFF), radius(6), weight(700), text_align(center)],
                )
            }
        }
    }
}
