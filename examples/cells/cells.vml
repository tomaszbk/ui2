Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Cells", x: 18, y: 14, width: 100, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    text: app.selected_address.len > 0 ? "Edit ${app.selected_address}" : "Select a cell",
                    x: 126,
                    y: 18,
                    width: 92,
                    height: 20,
                    style: [foreground(#64748B), font_size(11)],
                )
                TextInput(
                    id: "cell_input",
                    bind.text: app.edit_value,
                    on_submit: app.apply_edit(),
                    placeholder: "value or =sum(A1:B2)",
                    x: 220,
                    y: 12,
                    width: card.width - 340,
                    height: 38,
                    style: [background(#F8FAFC), radius(7), font_family("Courier New"), font_size(12)],
                )
                Button(
                    id: "apply_cell",
                    text: "Apply",
                    on_click: app.apply_edit(),
                    native: true,
                    x: card.width - 108,
                    y: 14,
                    width: 90,
                    height: 34,
                )
                View(
                    id: "sheet",
                    x: 18,
                    y: 64,
                    width: card.width - 36,
                    height: 280,
                    style: [background(#CBD5E1), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(x: 1, y: 1, width: 34, height: 32, style: [background(#334155)])
                        Repeater(
                            model: app.columns,
                            key: item.label,
                        ) {
                            View(
                                x: 37 + item.column *(((root.width - 68) - 38) / 5),
                                y: 1,
                                width: (((root.width - 68) - 38) / 5) - 2,
                                height: 32,
                                style: [background(#334155)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Label(
                                        text: item.label,
                                        x: 0,
                                        y: 0,
                                        width: (((root.width - 68) - 38) / 5) - 2,
                                        height: 32,
                                        style: [text_align(center), foreground(#FFFFFF), font_size(11), weight(700)],
                                    )
                                }
                            }
                        }
                        Repeater(
                            model: app.rows,
                            key: item.id,
                        ) {
                            View(
                                x: 1,
                                y: 35 + item.row * 40,
                                width: 34,
                                height: 38,
                                style: [background(#E2E8F0)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Label(
                                        text: item.label,
                                        x: 0,
                                        y: 0,
                                        width: 34,
                                        height: 38,
                                        style: [text_align(center), foreground(#475569), font_size(10), weight(700)],
                                    )
                                }
                            }
                        }
                        Repeater(
                            model: app.cells,
                            key: item.address,
                        ) {
                            Button(
                                text: item.formula ? "${item.display} ƒ" : item.display,
                                on_click: app.select_cell(item.id),
                                native: true,
                                x: 37 + item.column *(((root.width - 68) - 38) / 5),
                                y: 35 + item.row * 40,
                                width: (((root.width - 68) - 38) / 5) - 2,
                                height: 38,
                                style: [background(item.id == app.selected_id ? #DBEAFE : #FFFFFF), font_family("Courier New"), font_size(10)],
                            )
                        }
                    }
                }
                View(
                    x: 18,
                    y: 360,
                    width: card.width - 36,
                    height: 82,
                    style: [background(#F8FAFC), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: "Formula examples",
                            x: 12,
                            y: 10,
                            width: 130,
                            height: 18,
                            style: [foreground(#475569), font_size(11), weight(700)],
                        )
                        Label(
                            text: "B1 = sum(B2:C5, D2)",
                            x: 12,
                            y: 34,
                            width: (card.width - 70) / 3,
                            height: 20,
                            style: [foreground(#64748B), font_family("Courier New"), font_size(10)],
                        )
                        Label(
                            text: "C5 = sum(D2:D5)",
                            x: 20 +(card.width - 70) / 3,
                            y: 34,
                            width: (card.width - 70) / 3,
                            height: 20,
                            style: [foreground(#64748B), font_family("Courier New"), font_size(10)],
                        )
                        Label(
                            text: "A4 = sum(B4:D4)",
                            x: 28 +(card.width - 70) * 0.66,
                            y: 34,
                            width: (card.width - 70) / 3,
                            height: 20,
                            style: [foreground(#64748B), font_family("Courier New"), font_size(10)],
                        )
                    }
                }
                Label(
                    id: "cells_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(11)],
                )
            }
        }
    }
}
