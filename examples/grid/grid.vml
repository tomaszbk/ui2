Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Grid", x: 16, y: 14, width: card.width - 32, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    text: "A small responsive table",
                    x: 16,
                    y: 42,
                    width: card.width - 32,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                View(
                    id: table,
                    x: 16,
                    y: 76,
                    width: card.width - 32,
                    height: 132,
                    style: [background(#CBD5E1), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        for item in app.cells key item.id {
                            View(
                                x: 1 + item.column *((table.width - 2) / 3),
                                y: 1 + item.row * 43,
                                width: (table.width - 2) / 3 - 1,
                                height: 42,
                                style: [background(item.header ? #334155 :(item.row == 1 ? #FFFFFF : #F8FAFC))],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Label(
                                        text: item.text,
                                        x: 10,
                                        y: 0,
                                        width: (table.width - 2) / 3 - 21,
                                        height: 42,
                                        style: [foreground(item.header ? #FFFFFF : #1E293B), font_size(item.header ? 13 : 12), weight(item.header ? 700 : 400)],
                                    )
                                }
                            }
                        }
                    }
                }
                Label(
                    text: "3 columns · 2 data rows",
                    x: 16,
                    y: 224,
                    width: card.width - 32,
                    height: 20,
                    style: [foreground(#64748B), font_size(12), text_align(right)],
                )
            }
        }
    }
}
