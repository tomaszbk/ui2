Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Directory browser",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    id: "current_path",
                    text: app.path,
                    x: 18,
                    y: 44,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(11)],
                )
                Button(
                    id: "parent",
                    text: "Parent folder",
                    on_click: app.go_parent(),
                    native: true,
                    x: 18,
                    y: 74,
                    width: 130,
                    height: 34,
                )
                Button(
                    id: "choose",
                    text: "Choose current",
                    on_click: app.choose_current(),
                    native: true,
                    x: card.width - 158,
                    y: 74,
                    width: 140,
                    height: 34,
                )
                Scroll(
                    id: "folder_list",
                    x: 18,
                    y: 120,
                    width: card.width - 36,
                    height: card.height - 174,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.entries,
                            key: item.path,
                        ) {
                            Button(
                                text: "▸  ${item.name}",
                                on_click: app.open_entry(item.id),
                                native: true,
                                x: 8,
                                y: 6 + index * 38,
                                width: folder_list.width - 32,
                                height: 32,
                            )
                        }
                        Label(
                            hidden: app.entries.len > 0,
                            text: "No child folders",
                            x: 16,
                            y: 30,
                            width: folder_list.width - 32,
                            height: 24,
                            style: [text_align(center), foreground(#94A3B8), font_size(13)],
                        )
                    }
                }
                Label(
                    id: "browser_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(11)],
                )
            }
        }
    }
}
