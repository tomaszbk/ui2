Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Accent color", x: 18, y: 14, width: 260, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: reset,
                    text: "Reset",
                    on_click: callback_reset,
                    native: true,
                    x: card.width - 118,
                    y: 13,
                    width: 100,
                    height: 34,
                )
                Label(
                    text: "Drag the three channels. Every other color on this card is derived from the accent they make.",
                    x: 18,
                    y: 44,
                    width: card.width - 148,
                    height: 18,
                    style: [foreground(#64748B), font_size(11)],
                )
                Label(text: "R ${app.red}", x: 18, y: 78, width: 54, height: 20, style: [foreground(#B91C1C), font_size(12), weight(700)])
                View(
                    id: track_red,
                    on_pointer_down: callback_track_red,
                    on_pointer_drag: callback_track_red,
                    on_pointer_up: callback_track_red,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 76,
                    y: 76,
                    width: (root.width - 232),
                    height: 24,
                    style: [background(#E2E8F0), radius(12)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 0,
                            y: 0,
                            width: app.red_ratio *(root.width - 232),
                            height: 24,
                            style: [background(#FCA5A5), radius(12)],
                        )
                        View(
                            x: app.red_ratio *((root.width - 232) - 22),
                            y: 1,
                            width: 22,
                            height: 22,
                            style: [background(#DC2626), radius(11)],
                        )
                    }
                }
                Label(text: "G ${app.green}", x: 18, y: 114, width: 54, height: 20, style: [foreground(#15803D), font_size(12), weight(700)])
                View(
                    id: track_green,
                    on_pointer_down: callback_track_green,
                    on_pointer_drag: callback_track_green,
                    on_pointer_up: callback_track_green,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 76,
                    y: 112,
                    width: (root.width - 232),
                    height: 24,
                    style: [background(#E2E8F0), radius(12)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 0,
                            y: 0,
                            width: app.green_ratio *(root.width - 232),
                            height: 24,
                            style: [background(#86EFAC), radius(12)],
                        )
                        View(
                            x: app.green_ratio *((root.width - 232) - 22),
                            y: 1,
                            width: 22,
                            height: 22,
                            style: [background(#16A34A), radius(11)],
                        )
                    }
                }
                Label(text: "B ${app.blue}", x: 18, y: 150, width: 54, height: 20, style: [foreground(#1D4ED8), font_size(12), weight(700)])
                View(
                    id: track_blue,
                    on_pointer_down: callback_track_blue,
                    on_pointer_drag: callback_track_blue,
                    on_pointer_up: callback_track_blue,
                    clickable: true,
                    draggable: true,
                    cursor: "pointing_hand",
                    x: 76,
                    y: 148,
                    width: (root.width - 232),
                    height: 24,
                    style: [background(#E2E8F0), radius(12)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 0,
                            y: 0,
                            width: app.blue_ratio *(root.width - 232),
                            height: 24,
                            style: [background(#93C5FD), radius(12)],
                        )
                        View(
                            x: app.blue_ratio *((root.width - 232) - 22),
                            y: 1,
                            width: 22,
                            height: 22,
                            style: [background(#2563EB), radius(11)],
                        )
                    }
                }
                View(
                    id: accent_preview,
                    x: card.width - 122,
                    y: 76,
                    width: 104,
                    height: 96,
                    style: [background(app.accent), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            text: app.display_color(),
                            x: 0,
                            y: 38,
                            width: 104,
                            height: 20,
                            style: [text_align(center), foreground(app.font_color), font_size(12), weight(700)],
                        )
                    }
                }
                for item in app.swatches key item.key {
                    View(
                        x: 18 + item.index *((card.width - 36) / 4),
                        y: 192,
                        width: (card.width - 36) / 4 - 8,
                        height: 62,
                        style: [background(item.color), radius(8)],
                    ) {
                        Absolute(
                            style: [transparent(true)],
                        ) {
                            Label(
                                text: item.label,
                                x: 0,
                                y: 21,
                                width: (card.width - 36) / 4 - 8,
                                height: 20,
                                style: [text_align(center), foreground(item.role == "font" ? #111111 : app.font_color), font_size(12), weight(700)],
                            )
                        }
                    }
                }
                View(
                    id: demo_stack,
                    x: 18,
                    y: 272,
                    width: card.width - 36,
                    height: card.height - 330,
                    style: [background(app.tint), radius(10)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            x: 0,
                            y: 0,
                            width: card.width - 36,
                            height: 44,
                            style: [background(app.shade), radius(10)],
                        ) {
                            Absolute(
                                style: [transparent(true)],
                            ) {
                                Label(
                                    text: "Controls painted with the derived scheme",
                                    x: 16,
                                    y: 12,
                                    width: card.width - 68,
                                    height: 20,
                                    style: [foreground(app.font_color), font_size(13), weight(700)],
                                )
                            }
                        }
                        Button(
                            id: accent_action,
                            text: "Primary action",
                            x: 16,
                            y: 64,
                            width: 170,
                            height: 38,
                            style: [background(app.accent), foreground(app.font_color), font_size(13), radius(8)],
                        )
                        Checkbox(
                            id: subscribe,
                            text: "Subscribe",
                            checked: app.subscribed,
                            on_click: callback_subscribe,
                            x: 202,
                            y: 70,
                            width: 150,
                            height: 26,
                            style: [foreground(app.shade), font_size(12)],
                        )
                        TextInput(
                            id: sample_input,
                            text: app.sample,
                            on_change: callback_sample_input,
                            x: 16,
                            y: 116,
                            width: 336,
                            height: 36,
                            style: [background(#FFFFFF), foreground(app.shade), radius(8)],
                        )
                        Label(
                            text: "Body text sits on the tint and reads in the shade.",
                            x: 16,
                            y: 164,
                            width: card.width - 68,
                            height: 20,
                            style: [foreground(app.shade), font_size(12)],
                        )
                        Label(
                            text: app.on_dark ? "The accent is dark, so the font color is white." : "The accent is light, so the font color is black.",
                            x: 16,
                            y: 188,
                            width: card.width - 68,
                            height: 20,
                            style: [foreground(app.shade), font_size(11)],
                        )
                    }
                }
                Label(
                    id: accent_status,
                    text: app.status,
                    x: 18,
                    y: card.height - 42,
                    width: card.width - 36,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
