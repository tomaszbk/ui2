Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Box layout inside a row",
                    x: 20,
                    y: 14,
                    width: card.width - 40,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "The outer inset behaves like the original row margin.",
                    x: 20,
                    y: 42,
                    width: card.width - 40,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                View(
                    id: stage,
                    x: 20,
                    y: 76,
                    width: card.width - 40,
                    height: card.height - 134,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        View(
                            id: red_box,
                            x: 0,
                            y: 0,
                            width: stage.width * 0.3,
                            height: stage.height * 0.3,
                            style: [background(#FF6464), radius(8)],
                        )
                        View(
                            id: green_box,
                            x: stage.width * 0.3,
                            y: stage.height * 0.3,
                            width: stage.width * 0.4,
                            height: stage.height * 0.4,
                            style: [background(#86EFAC), radius(8)],
                        )
                        TextArea(
                            id: moving_text,
                            bind.text: app.text,
                            x: stage.width *(app.moved ? 0.8 : 0.7),
                            y: stage.height *(app.moved ? 0.8 : 0.7),
                            width: stage.width *(app.moved ? 0.2 : 0.3),
                            height: stage.height *(app.moved ? 0.2 : 0.3),
                            style: [background(#FEF3C7), foreground(#713F12), font_size(11), radius(7)],
                        )
                        Button(
                            id: move_text,
                            text: app.moved ? "Restore" : "Move text",
                            on_click: app.toggle_position(),
                            native: true,
                            x: stage.width * 0.7,
                            y: stage.height * 0.1,
                            width: stage.width * 0.25,
                            height: 36,
                        )
                    }
                }
                Label(
                    id: layout_status,
                    text: app.status,
                    x: 20,
                    y: card.height - 42,
                    width: card.width - 40,
                    height: 20,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
