Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "controls",
            x: 16,
            y: 16,
            width: (190),
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Controls",
                    x: 16,
                    y: 14,
                    width: controls.width - 32,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Button(
                    id: "add_last",
                    text: "Add last",
                    on_click: app.add_last(),
                    native: true,
                    x: 16,
                    y: 56,
                    width: controls.width - 32,
                    height: 34,
                )
                Button(
                    id: "add_two",
                    text: "Add two",
                    on_click: app.add_two(),
                    native: true,
                    x: 16,
                    y: 98,
                    width: controls.width - 32,
                    height: 34,
                )
                Button(
                    id: "remove_last",
                    text: "Remove last",
                    on_click: app.remove_last(),
                    native: true,
                    enabled: app.items.len > 0,
                    x: 16,
                    y: 140,
                    width: controls.width - 32,
                    height: 34,
                )
                Button(
                    id: "remove_second",
                    text: "Remove second",
                    on_click: app.remove_second(),
                    native: true,
                    enabled: app.items.len > 1,
                    x: 16,
                    y: 182,
                    width: controls.width - 32,
                    height: 34,
                )
                Button(
                    id: "move_first",
                    text: "Move first to end",
                    on_click: app.move_first(),
                    native: true,
                    enabled: app.items.len > 1,
                    x: 16,
                    y: 224,
                    width: controls.width - 32,
                    height: 34,
                )
                Button(
                    id: "toggle_items",
                    text: app.items_hidden ? "Show buttons" : "Hide buttons",
                    on_click: app.toggle_items(),
                    native: true,
                    x: 16,
                    y: 266,
                    width: controls.width - 32,
                    height: 34,
                )
                Label(
                    text: app.status,
                    x: 16,
                    y: controls.height - 42,
                    width: controls.width - 32,
                    height: 20,
                    style: [text_align(center), foreground(#64748B), font_size(12)],
                )
            }
        }
        View(
            id: "stage",
            x: 222,
            y: 16,
            width: root.width - 238,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Live layout",
                    x: 16,
                    y: 14,
                    width: stage.width - 32,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Click a generated button to rename it.",
                    x: 16,
                    y: 42,
                    width: stage.width - 32,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                Scroll(
                    id: "item_list",
                    hidden: app.items_hidden,
                    x: 16,
                    y: 76,
                    width: stage.width - 32,
                    height: stage.height - 92,
                    style: [background(#F8FAFC)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.items,
                            key: item.id,
                        ) {
                            Button(
                                text: item.label,
                                on_click: app.rename(item.id),
                                native: true,
                                x: 12,
                                y: 10 + index * 44,
                                width: stage.width - 72,
                                height: 34,
                            )
                        }
                    }
                }
                Label(
                    id: "hidden_message",
                    hidden: ! app.items_hidden,
                    text: "Generated buttons are hidden",
                    x: 16,
                    y: stage.height / 2 - 10,
                    width: stage.width - 32,
                    height: 20,
                    style: [text_align(center), foreground(#64748B), font_size(13)],
                )
            }
        }
    }
}
