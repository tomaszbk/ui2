Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: ((root.width -(root.width - 32 < 288 ? root.width - 32 : 288)) / 2),
            y: 16,
            width: (root.width - 32 < 288 ? root.width - 32 : 288),
            height: 128,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    id: state,
                    text: app.enabled ? "Enabled" : "Disabled",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 34,
                    style: [foreground(app.enabled ? #166534 : #991B1B), font_size(20), weight(700)],
                )
                Label(text: "Feature enabled", x: 16, y: 62, width: card.width - 96, height: 42, style: [foreground(#111827), font_size(15)])
                Switch(
                    id: switch_control,
                    bind.active: app.enabled,
                    x: card.width - 76,
                    y: 67,
                    width: 60,
                    height: 32,
                    active_color: #16A34A,
                )
            }
        }
    }
}
