Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Column(
        style: [padding(16), transparent(true)],
    ) {
        Column(
            id: "card",
            flex_grow: 1,
            gap: 12,
            style: [padding(18), background(#FFFFFF), radius(10)],
        ) {
            Label(text: "Users", height: 28, style: [foreground(#111827), font_size(18), weight(700)])
            Label(
                text: "A fixed form column beside a table pane that grows with the window.",
                height: 18,
                style: [foreground(#64748B), font_size(11)],
            )
            Row(
                flex_grow: 1,
                gap: 32,
                style: [transparent(true)],
            ) {
                Column(
                    id: "form",
                    width: 232,
                    flex_shrink: 0,
                    gap: 4,
                    style: [padding(16), background(#F8FAFC), radius(9)],
                ) {
                    TextInput(
                        id: "first_name",
                        placeholder: "First name",
                        bind.text: app.first_name,
                        on_change: app.first_name_changed(),
                        height: 34,
                        style: [background(app.is_error ? #FEE2E2 : #FFFFFF), radius(7)],
                    )
                    TextInput(
                        id: "last_name",
                        placeholder: "Last name",
                        bind.text: app.last_name,
                        on_change: app.last_name_changed(),
                        height: 34,
                        style: [background(app.is_error ? #FEE2E2 : #FFFFFF), radius(7)],
                    )
                    TextInput(
                        id: "age",
                        placeholder: "Age",
                        bind.text: app.age,
                        on_change: app.age_changed(),
                        keyboard: decimal,
                        height: 34,
                        style: [background(app.is_error ? #FEE2E2 : #FFFFFF), radius(7)],
                    )
                    TextInput(
                        id: "password",
                        placeholder: "Password",
                        bind.text: app.password,
                        secure: true,
                        height: 34,
                        style: [background(#FFFFFF), radius(7)],
                    )
                    Checkbox(
                        id: "online",
                        text: "Online registration",
                        checked: app.online,
                        on_click: app.toggle_online(),
                        height: 26,
                        style: [foreground(#1E293B), font_size(12)],
                    )
                    Checkbox(
                        id: "subscribed",
                        text: "Subscribe to the newsletter",
                        checked: app.subscribed,
                        on_click: app.toggle_subscribed(),
                        height: 26,
                        style: [foreground(#1E293B), font_size(12)],
                    )
                    Label(text: "Country", height: 18, style: [foreground(#334155), font_size(12), weight(700)])
                    Repeater(
                        model: app.countries,
                        key: item.key,
                    ) {
                        Checkbox(
                            text: item.name,
                            checked: item.name == app.country,
                            on_click: app.select_country(item.name),
                            height: 26,
                            style: [foreground(#1E293B), font_size(12)],
                        )
                    }
                    Row(
                        height: 34,
                        gap: 6,
                        style: [transparent(true)],
                    ) {
                        Button(
                            id: "add_user",
                            text: "Add user",
                            on_click: app.add_user(),
                            native: true,
                            tooltip: "Required fields:\nFirst name, last name, age",
                            flex_grow: 1,
                        )
                        Button(id: "about", text: "?", on_click: app.about(), native: true, tooltip: "about", width: 44)
                        Button(id: "reset", text: "Clear", on_click: app.reset(), native: true, width: 44)
                    }
                    View(flex_grow: 1, style: [transparent(true)])
                    Progress(height: 14, value: app.progress, max: 1)
                    Label(
                        id: "progress_label",
                        text: app.progress_label,
                        height: 18,
                        style: [text_align(center), foreground(#334155), font_size(11)],
                    )
                }
                Column(
                    id: "table",
                    flex_grow: 1,
                    gap: 4,
                    style: [padding(14), background(#FFF0F0), radius(9)],
                ) {
                    Row(
                        height: 28,
                        style: [padding(6), background(#334155), radius(6)],
                    ) {
                        Label(text: "First name", flex_basis: 0, flex_grow: 1, style: [foreground(#F8FAFC), font_size(11), weight(700)])
                        Label(text: "Last name", flex_basis: 0, flex_grow: 1, style: [foreground(#F8FAFC), font_size(11), weight(700)])
                        Label(text: "Age", flex_basis: 0, flex_grow: 1, style: [foreground(#F8FAFC), font_size(11), weight(700)])
                        Label(text: "Country", flex_basis: 0, flex_grow: 1, style: [foreground(#F8FAFC), font_size(11), weight(700)])
                    }
                    Scroll(
                        id: "user_rows",
                        flex_grow: 1,
                        style: [background(#FFFFFF)],
                    ) {
                        Column(
                            height: app.users.len * 30,
                            gap: 1,
                            style: [transparent(true)],
                        ) {
                            Repeater(
                                model: app.users,
                                key: item.key,
                            ) {
                                Row(
                                    height: 29,
                                    flex_shrink: 0,
                                    align_items: center,
                                    style: [padding_left(10), padding_right(10), background(item.stripe)],
                                ) {
                                    Label(
                                        text: item.first_name,
                                        flex_basis: 0,
                                        flex_grow: 1,
                                        height: 18,
                                        style: [foreground(#0F172A), font_size(12)],
                                    )
                                    Label(
                                        text: item.last_name,
                                        flex_basis: 0,
                                        flex_grow: 1,
                                        height: 18,
                                        style: [foreground(#0F172A), font_size(12)],
                                    )
                                    Label(text: item.age, flex_basis: 0, flex_grow: 1, height: 18, style: [foreground(#0F172A), font_size(12)])
                                    Label(
                                        text: item.country,
                                        flex_basis: 0,
                                        flex_grow: 1,
                                        height: 18,
                                        style: [foreground(#475569), font_size(12)],
                                    )
                                }
                            }
                        }
                    }
                    Row(
                        height: 56,
                        gap: 12,
                        align_items: center,
                        style: [transparent(true)],
                    ) {
                        Label(
                            id: "users_status",
                            text: app.status,
                            flex_grow: 1,
                            height: 20,
                            style: [foreground(app.is_error ? #991B1B : #166534), font_size(12)],
                        )
                        Image(id: "users_logo", source: app.logo_path, width: 56, height: 56)
                    }
                }
            }
        }
    }
}
