// Settings pages in kit Tabs. The Tabs binds the selected page's value; the
// other pages stay mounted while hidden, and a segmented Tabs bound to the
// same value switches them too.
Screen(id: root, style: [background(color.surface)]) {
    Column(id: page, gap: 12, style: [padding(20)]) {
        Label(text: "Settings", style: [font_size(typography.title), weight(700), foreground(color.text)])
        Tabs(id: settings, bind.value: app.tab, flex_grow: 1) {
            Tab(value: "account", text: "Account", icon: circle_user, gap: 8) {
                Label(text: "Profile", style: [weight(600), foreground(color.text)])
                Label(text: "Your name and photo are shown on your public page.", style: [foreground(color.muted)])
            }
            Tab(value: "password", text: "Password", icon: padlock, gap: 8) {
                Label(text: "Password", style: [weight(600), foreground(color.text)])
                Label(text: "Change it regularly and never reuse it.", style: [foreground(color.muted)])
            }
            Tab(value: "billing", text: "Billing", enabled: false) {
                Label(text: "Billing is managed by your organization.")
            }
            Tab(value: "notifications", text: "Notifications", icon: bell, gap: 8) {
                Label(text: "Notifications", style: [weight(600), foreground(color.text)])
                Label(text: "Choose which alerts you receive.", style: [foreground(color.muted)])
            }
        }
        Row(gap: 12, align_items: center) {
            Tabs(id: compact, bind.value: app.tab, variant: segmented, size: small) {
                Tab(value: "account", text: "Account")
                Tab(value: "password", text: "Password")
                Tab(value: "notifications", text: "Notifications")
            }
            Label(id: status, text: "Showing ${app.tab}", style: [foreground(color.muted)])
        }
    }
}
