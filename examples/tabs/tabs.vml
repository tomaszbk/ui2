Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Tabs", x: 18, y: 14, width: card.width - 36, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    text: "Switch between three component pages.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 20,
                    style: [foreground(#64748B), font_size(12)],
                )
                View(
                    id: "tab_bar",
                    x: 18,
                    y: 74,
                    width: card.width - 36,
                    height: 44,
                    style: [background(#F8FAFC), radius(8)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.pages,
                            key: item.id,
                        ) {
                            Button(
                                text: item.id == app.active_tab ? "• ${item.title}" : item.title,
                                on_click: app.select_tab(item.id),
                                native: true,
                                x: 8 + index *((tab_bar.width - 16) / 3),
                                y: 5,
                                width: (tab_bar.width - 16) / 3 - 8,
                                height: 34,
                            )
                        }
                    }
                }
                View(
                    id: "tab_stage",
                    x: 18,
                    y: 130,
                    width: card.width - 36,
                    height: card.height - 184,
                    style: [background(#F8FAFC), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Repeater(
                            model: app.pages,
                            key: item.id,
                        ) {
                            View(
                                hidden: item.id != app.active_tab,
                                x: 8,
                                y: 8,
                                width: tab_stage.width - 16,
                                height: tab_stage.height - 16,
                                style: [background(item.background), radius(8)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    Label(
                                        text: item.heading,
                                        x: 20,
                                        y: 24,
                                        width: tab_stage.width - 56,
                                        height: 30,
                                        style: [foreground(#111827), font_size(20), weight(700)],
                                    )
                                    Label(
                                        text: item.body,
                                        x: 20,
                                        y: 66,
                                        width: tab_stage.width - 56,
                                        height: 46,
                                        style: [foreground(#334155), font_size(13), lines(2)],
                                    )
                                    Label(
                                        text: "Page ${item.id} of ${app.pages.len}",
                                        x: 20,
                                        y: tab_stage.height - 54,
                                        width: tab_stage.width - 56,
                                        height: 20,
                                        style: [text_align(right), foreground(#64748B), font_size(11)],
                                    )
                                }
                            }
                        }
                    }
                }
                Label(
                    id: "tab_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#166534), font_size(12)],
                )
            }
        }
    }
}
