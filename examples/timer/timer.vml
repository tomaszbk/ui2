Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Column(
        style: [padding(16), transparent(true)],
    ) {
        Column(
            id: "card",
            flex_grow: 1,
            gap: 10,
            style: [padding(20), background(#FFFFFF), radius(10)],
        ) {
            Row(
                height: 34,
                align_items: center,
                style: [transparent(true)],
            ) {
                Label(text: "Timer", flex_grow: 1, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Label(
                    text: app.elapsed_label,
                    width: 152,
                    height: 34,
                    style: [text_align(right), foreground(#2563EB), font_size(21), weight(700), font_family("Courier New")],
                )
            }
            Label(text: "Elapsed time", height: 20, style: [foreground(#475569), font_size(12)])
            Progress(
                id: "elapsed_progress",
                height: 28,
                value: app.elapsed,
                max: app.duration,
                accessibility_label: "Elapsed time",
            )
            View(height: 12, style: [transparent(true)])
            Row(
                height: 20,
                style: [transparent(true)],
            ) {
                Label(text: "Duration", flex_grow: 1, style: [foreground(#475569), font_size(12), weight(700)])
                Label(text: app.duration_label, width: 140, style: [text_align(right), foreground(#334155), font_size(12)])
            }
            Column(
                gap: 6,
                style: [padding_left(16), padding_right(16), transparent(true)],
            ) {
                Slider(
                    track_inset: 11,
                    id: "duration_slider",
                    on_change: callback_duration_slider,
                    height: 24,
                    min: 1,
                    max: 30,
                    value: app.duration,
                    step: 1,
                    value_track: true,
                    value_track_color: #BFDBFE,
                    thumb_color: #2563EB,
                    thumb_size: 22,
                    accessibility_label: "Timer duration",
                    style: [background(#CBD5E1)],
                )
                Row(
                    height: 18,
                    style: [transparent(true)],
                ) {
                    Label(text: "1 s", flex_grow: 1, style: [foreground(#64748B), font_size(10)])
                    Label(text: "30 s", width: 50, style: [text_align(right), foreground(#64748B), font_size(10)])
                }
            }
            Row(
                justify: center,
                gap: 16,
                height: 34,
                style: [transparent(true)],
            ) {
                Button(id: "start", text: app.start_label, on_click: callback_start, native: true, width: 110, height: 34)
                Button(
                    id: "pause",
                    text: app.running ? "Pause" : "Resume",
                    on_click: callback_pause,
                    native: true,
                    enabled: app.elapsed > 0 && app.elapsed < app.duration,
                    width: 110,
                    height: 34,
                )
            }
            View(flex_grow: 1, style: [transparent(true)])
            Label(id: "timer_status", text: app.status, height: 18, style: [text_align(center), foreground(#166534), font_size(11)])
        }
    }
}
