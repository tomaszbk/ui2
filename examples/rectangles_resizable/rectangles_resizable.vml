Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Resizable rectangles",
                    x: 18,
                    y: 14,
                    width: card.width - 36,
                    height: 28,
                    style: [text_align(center), foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Each rounded box takes an equal share of the available row.",
                    x: 18,
                    y: 42,
                    width: card.width - 36,
                    height: 18,
                    style: [text_align(center), foreground(#64748B), font_size(11)],
                )
                Repeater(
                    model: app.colors,
                    key: item.id,
                ) {
                    View(
                        x: 18 + index *((card.width - 62) / 4 + 8),
                        y: 72,
                        width: (card.width - 62) / 4,
                        height: card.height - 90,
                        style: [background(item.color), radius(10)],
                    ) {
                        Absolute(
                            style: [transparent(true)],
                        ) {
                            Label(
                                text: item.name,
                                x: 0,
                                y: (card.height - 110) / 2,
                                width: (card.width - 62) / 4,
                                height: 20,
                                style: [text_align(center), foreground(item.text_color), font_size(13), weight(700)],
                            )
                        }
                    }
                }
            }
        }
    }
}
