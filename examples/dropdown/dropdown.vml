Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: ((root.width -(root.width - 32 < 328 ? root.width - 32 : 328)) / 2),
            y: 16,
            width: (root.width - 32 < 328 ? root.width - 32 : 328),
            height: 188,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "User actions",
                    x: 16,
                    y: 16,
                    width: card.width - 32,
                    height: 26,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Dropdown(
                    id: actions,
                    bind.text: app.selection,
                    on_change: app.selection_changed(),
                    x: 16,
                    y: 54,
                    width: card.width - 32,
                    height: 42,
                    style: [background(#DBEAFE), foreground(#1D4ED8), radius(7)],
                ) {
                    Option(text: "Delete all users")
                    Option(text: "Export users")
                    Option(text: "Exit")
                }
                View(
                    x: 16,
                    y: 112,
                    width: card.width - 32,
                    height: 56,
                    style: [background(#DCFCE7), radius(7)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            id: selection_message,
                            text: app.message,
                            x: 10,
                            y: 19,
                            width: card.width - 52,
                            height: 18,
                            style: [foreground(#166534), font_size(13), text_align(center)],
                        )
                    }
                }
            }
        }
    }
}
