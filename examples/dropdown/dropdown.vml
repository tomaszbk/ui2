Screen(
    id: "root",
    background: #F1F5F9,
) {
    Absolute(
        transparent: true,
    ) {
        View(
            id: "card",
            x: ((root.width -(root.width - 32 < 328 ? root.width - 32 : 328)) / 2),
            y: 16,
            width: (root.width - 32 < 328 ? root.width - 32 : 328),
            height: 188,
            background: #FFFFFF,
            corner_radius: 10,
        ) {
            Absolute(
                transparent: true,
            ) {
                Label(
                    text: "User actions",
                    x: 16,
                    y: 16,
                    width: card.width - 32,
                    height: 26,
                    color: #111827,
                    font_size: 18,
                    bold: true,
                )
                Dropdown(
                    id: "actions",
                    bind.text: app.selection,
                    on_change: app.selection_changed(),
                    x: 16,
                    y: 54,
                    width: card.width - 32,
                    height: 42,
                    background: #DBEAFE,
                    color: #1D4ED8,
                    corner_radius: 7,
                ) {
                    Option(text: "Delete all users")
                    Option(text: "Export users")
                    Option(text: "Exit")
                }
                View(
                    x: 16,
                    y: 112,
                    width: card.width - 32,
                    height: 56,
                    background: #DCFCE7,
                    corner_radius: 7,
                ) {
                    Absolute(
                        transparent: true,
                    ) {
                        Label(
                            id: "selection-message",
                            text: app.message,
                            x: 10,
                            y: 19,
                            width: card.width - 52,
                            height: 18,
                            color: #166534,
                            font_size: 13,
                            align: center,
                        )
                    }
                }
            }
        }
    }
}
