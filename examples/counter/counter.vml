Screen {
    id: root
    background: #F1F5F9

    Flex {
        padding: 16
        justify: center
        align_items: center
        transparent: true

        Row {
            id: card
            width: 248
            max_width: 248
            height: 64
            padding: 12
            gap: 8
            background: #FFFFFF
            corner_radius: 10

            Row {
                flex_grow: 1
                padding_left: 8
                padding_right: 8
                background: #F8FAFC
                corner_radius: 7
                Label { id: count text: app.count flex_grow: 1 color: #111827 font_size: 20 align: right }
            }
            Button { id: increment text: "Count" on_tap: app.increment() native: true width: 96 height: 40 background: #3478D4 color: #FFFFFF bold: true align: center corner_radius: 7 }
        }
    }
}
