import Counter

Screen(id: "root", background: #F1F5F9) {
    Column(padding: 16, gap: 12) {
        Row(gap: 12, height: 188) {
            Counter(id: "first", title: "First", on_changed: app.observe)
            Counter(id: "second", title: "Second")
        }
        Label(text: "First counter emitted ${app.events} events; its latest value is ${app.last_value}.", height: 24, color: #166534)
    }
}
