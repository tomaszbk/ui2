Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Scrollview",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 28,
                    style: [foreground(#111827), font_size(18), weight(700)],
                )
                Label(
                    text: "Information",
                    x: 16,
                    y: 52,
                    width: ((root.width - 80) / 2),
                    height: 20,
                    style: [foreground(#475569), font_size(12)],
                )
                Label(
                    text: "Generated lines",
                    x: 32 +((root.width - 80) / 2),
                    y: 52,
                    width: ((root.width - 80) / 2),
                    height: 20,
                    style: [foreground(#475569), font_size(12)],
                )
                TextArea(
                    id: "info",
                    text: app.info,
                    readonly: true,
                    x: 16,
                    y: 76,
                    width: ((root.width - 80) / 2),
                    height: card.height - 92,
                    style: [background(#F8FAFC), foreground(#334155), font_size(13), radius(7)],
                )
                TextArea(
                    id: "text",
                    text: app.text,
                    readonly: true,
                    x: 32 +((root.width - 80) / 2),
                    y: 76,
                    width: ((root.width - 80) / 2),
                    height: card.height - 92,
                    style: [background(#FCF4E4), foreground(#334155), font_size(13), radius(7)],
                )
            }
        }
    }
}
