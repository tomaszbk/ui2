Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        Label(text: "Paged content", x: 20, y: 14, width: root.width - 40, height: 30, style: [foreground(#0F172A), font_size(20), weight(700)])
        ScreenManager(
            id: pager,
            x: 20,
            y: 54,
            width: root.width - 40,
            height: 160,
            current: "${app.page}",
            style: [background(#CBD5E1), radius(10)],
        ) {
            Screen(
                name: "0",
                style: [background(#DBEAFE)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(text: "Page one", x: 24, y: 52, width: 240, height: 40, style: [foreground(#1E3A8A), font_size(24), weight(700)])
                }
            }
            Screen(
                name: "1",
                style: [background(#DCFCE7)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(text: "Page two", x: 24, y: 52, width: 240, height: 40, style: [foreground(#14532D), font_size(24), weight(700)])
                }
            }
            Screen(
                name: "2",
                style: [background(#FCE7F3)],
            ) {
                Absolute(
                    style: [transparent(true)],
                ) {
                    Label(text: "Page three", x: 24, y: 52, width: 240, height: 40, style: [foreground(#831843), font_size(24), weight(700)])
                }
            }
        }
        Button(id: previous, text: "Previous", on_click: app.previous(), x: 20, y: 226, width: 110, height: 38)
        Label(text: "${app.page + 1} / 3", x: 160, y: 226, width: 100, height: 38, style: [text_align(center), foreground(#475569)])
        Button(id: next, text: "Next", on_click: app.next(), x: root.width - 130, y: 226, width: 110, height: 38)
    }
}
