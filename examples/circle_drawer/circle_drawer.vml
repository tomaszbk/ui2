Screen(
    id: "root",
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: "card",
            x: 16,
            y: 16,
            width: root.width - 32,
            height: root.height - 32,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(text: "Circle drawer", x: 18, y: 14, width: 180, height: 28, style: [foreground(#111827), font_size(18), weight(700)])
                Button(
                    id: "undo",
                    text: "Undo",
                    on_click: callback_undo,
                    enabled: app.can_undo,
                    native: true,
                    x: card.width - 346,
                    y: 13,
                    width: 82,
                    height: 34,
                )
                Button(
                    id: "redo",
                    text: "Redo",
                    on_click: callback_redo,
                    enabled: app.can_redo,
                    native: true,
                    x: card.width - 256,
                    y: 13,
                    width: 82,
                    height: 34,
                )
                Button(
                    id: "radius_less",
                    text: "Radius −",
                    on_click: callback_radius_less,
                    enabled: app.selected_id >= 0,
                    native: true,
                    x: card.width - 166,
                    y: 13,
                    width: 82,
                    height: 34,
                )
                Button(
                    id: "radius_more",
                    text: "+",
                    on_click: callback_radius_more,
                    enabled: app.selected_id >= 0,
                    native: true,
                    x: card.width - 76,
                    y: 13,
                    width: 58,
                    height: 34,
                )
                View(
                    id: "circle_canvas",
                    on_pointer_up: callback_circle_canvas,
                    clickable: true,
                    cursor: "pointing_hand",
                    x: 18,
                    y: 76,
                    width: card.width - 36,
                    height: card.height - 132,
                    style: [background(#F8FAFC), radius(9)],
                ) {
                    Absolute(
                        style: [transparent(true)],
                    ) {
                        Label(
                            hidden: app.circles.len > 0,
                            text: "Click anywhere to add the first circle",
                            x: 20,
                            y: (circle_canvas.height - 24) / 2,
                            width: circle_canvas.width - 40,
                            height: 24,
                            style: [text_align(center), foreground(#94A3B8), font_size(13)],
                        )
                        Repeater(
                            model: app.circles,
                            key: item.id,
                        ) {
                            View(
                                x: item.x - item.radius - 3,
                                y: item.y - item.radius - 3,
                                width: item.radius * 2 + 6,
                                height: item.radius * 2 + 6,
                                style: [background(item.id == app.selected_id ? #2563EB : #FFFFFF), radius(item.radius + 3)],
                            ) {
                                Absolute(
                                    style: [transparent(true)],
                                ) {
                                    View(
                                        x: 3,
                                        y: 3,
                                        width: item.radius * 2,
                                        height: item.radius * 2,
                                        style: [background(item.color), radius(item.radius)],
                                    ) {
                                        Absolute(
                                            style: [transparent(true)],
                                        ) {
                                            Label(
                                                text: "${item.id}",
                                                x: 0,
                                                y: 0,
                                                width: item.radius * 2,
                                                height: item.radius * 2,
                                                style: [text_align(center), foreground(#1E293B), font_size(11), weight(700)],
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Label(
                    id: "circle_status",
                    text: app.status,
                    x: 18,
                    y: card.height - 40,
                    width: card.width - 130,
                    height: 18,
                    style: [foreground(#166534), font_size(11)],
                )
                Label(
                    text: app.radius_label,
                    x: card.width - 116,
                    y: card.height - 40,
                    width: 98,
                    height: 18,
                    style: [text_align(right), foreground(#64748B), font_size(11)],
                )
            }
        }
    }
}
