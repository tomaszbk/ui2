Screen(
    id: root,
    style: [background(#F1F5F9)],
) {
    Absolute(
        style: [transparent(true)],
    ) {
        View(
            id: card,
            x: ((root.width -(root.width - 32 < 328 ? root.width - 32 : 328)) / 2),
            y: 16,
            width: (root.width - 32 < 328 ? root.width - 32 : 328),
            height: 140,
            style: [background(#FFFFFF), radius(10)],
        ) {
            Absolute(
                style: [transparent(true)],
            ) {
                Label(
                    text: "Four rectangles",
                    x: 16,
                    y: 14,
                    width: card.width - 32,
                    height: 24,
                    style: [foreground(#111827), font_size(18), weight(700), text_align(center)],
                )
                View(
                    id: red,
                    x: (((root.width - 32 < 328 ? root.width - 32 : 328) - 286) / 2),
                    y: 54,
                    width: 64,
                    height: 64,
                    style: [background(#FF6464)],
                )
                View(
                    id: green,
                    x: (((root.width - 32 < 328 ? root.width - 32 : 328) - 286) / 2) + 74,
                    y: 54,
                    width: 64,
                    height: 64,
                    style: [background(#64FF64)],
                )
                View(
                    id: blue,
                    x: (((root.width - 32 < 328 ? root.width - 32 : 328) - 286) / 2) + 148,
                    y: 54,
                    width: 64,
                    height: 64,
                    style: [background(#6464FF)],
                )
                View(
                    id: magenta,
                    x: (((root.width - 32 < 328 ? root.width - 32 : 328) - 286) / 2) + 222,
                    y: 54,
                    width: 64,
                    height: 64,
                    style: [background(#FF64FF)],
                )
            }
        }
    }
}
